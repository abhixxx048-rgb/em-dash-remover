---
import Base from './Base.astro';
import { SITE_NAME, AUTHOR } from '../consts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
}
const { title, description, pubDate, updatedDate } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, ''), Astro.site).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: AUTHOR },
  publisher: { '@id': `${Astro.site}#org` },
  mainEntityOfPage: canonical,
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ],
};
---

<Base title={`${title} — ${SITE_NAME}`} description={description}>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <nav class="text-sm muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a> ›
      <a href="/blog" class="hover:text-accent">Blog</a> ›
      <span>{title}</span>
    </nav>

    <h1 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl">{title}</h1>
    <p class="mt-3 text-sm muted">
      By {AUTHOR} · Published {fmt(pubDate)}{updatedDate && ` · Updated ${fmt(updatedDate)}`}
    </p>

    <article class="prose-page mt-8 leading-relaxed">
      <slot />
    </article>

    <div class="mt-12 rounded-2xl p-6 text-center" style="background: var(--c-accent-soft);">
      <p class="font-semibold">Try the free em dash remover</p>
      <p class="mt-1 text-sm muted">Clean em dashes, smart quotes and AI tells from any text — 100% in your browser.</p>
      <a href="/" class="mt-3 inline-flex min-h-11 items-center rounded-lg bg-accent px-5 font-semibold text-white transition hover:opacity-90">Open the tool</a>
    </div>

    <p class="mt-10"><a href="/blog" class="text-accent hover:underline">← Back to all articles</a></p>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <style is:global>
    .prose-page h2 { font-size: 1.4rem; font-weight: 700; margin-top: 2rem; margin-bottom: 0.5rem; }
    .prose-page h3 { font-size: 1.1rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.35rem; }
    .prose-page p { margin-top: 0.85rem; color: color-mix(in srgb, var(--c-ink) 82%, transparent); }
    .prose-page a { color: var(--color-accent); text-decoration: underline; }
    .prose-page ul { list-style: disc; padding-left: 1.4rem; margin-top: 0.85rem; }
    .prose-page ol { list-style: decimal; padding-left: 1.4rem; margin-top: 0.85rem; }
    .prose-page li { margin-top: 0.35rem; color: color-mix(in srgb, var(--c-ink) 82%, transparent); }
    .prose-page strong { color: var(--c-ink); }
    .prose-page blockquote { border-left: 3px solid var(--color-accent); padding-left: 1rem; margin: 1rem 0; font-style: italic; color: var(--c-muted); }
    .prose-page table { width: 100%; margin-top: 1rem; border-collapse: collapse; font-size: 0.9rem; }
    /* On phones a wide table would push the page sideways — let it scroll instead. */
    @media (max-width: 767px) { .prose-page table { display: block; max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; } }
    .prose-page th, .prose-page td { border: 1px solid color-mix(in srgb, var(--c-ink) 12%, transparent); padding: 0.5rem 0.7rem; text-align: left; }
    .prose-page code { background: color-mix(in srgb, var(--c-ink) 8%, transparent); padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.9em; }
  </style>
</Base>
