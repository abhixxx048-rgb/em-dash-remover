---
import Base from './Base.astro';
import { SITE_NAME, AUTHOR } from '../consts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
}
const { title, description, pubDate, updatedDate } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, ''), Astro.site).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: AUTHOR },
  publisher: { '@id': `${Astro.site}#org` },
  mainEntityOfPage: canonical,
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ],
};
---

<Base title={`${title} - ${SITE_NAME}`} description={description}>
  <main class="mx-auto max-w-2xl px-4 py-14">
    <nav class="post-crumb" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/blog" class="hover:text-accent">Blog</a>
    </nav>

    <p class="eyebrow text-mark mt-7">The Margin Notes</p>
    <h1 class="mt-3 text-3xl tracking-tight sm:text-4xl">{title}</h1>
    <p class="post-byline mt-4">
      <span>By {AUTHOR}</span>
      <span aria-hidden="true" class="post-byline-dot">·</span>
      <span>Published {fmt(pubDate)}</span>
      {updatedDate && (
        <>
          <span aria-hidden="true" class="post-byline-dot">·</span>
          <span>Updated {fmt(updatedDate)}</span>
        </>
      )}
    </p>

    <hr class="rule-dash mt-8" />

    <article class="prose-page mt-8 leading-relaxed">
      <slot />
    </article>

    <hr class="rule-dash mt-14" />

    <aside class="post-cta mt-8">
      <p class="eyebrow text-mark">Clean it up</p>
      <p class="mt-2 text-xl">Try the free em dash remover</p>
      <p class="mt-1.5 text-sm muted">Strike em dashes, smart quotes and AI tells from any text — 100% in your browser.</p>
      <a href="/" class="mt-4 inline-flex min-h-11 items-center rounded-lg bg-accent px-5 font-semibold text-white transition hover:opacity-90">Open the tool →</a>
    </aside>

    <p class="mt-10"><a href="/blog" class="post-back">← Back to all articles</a></p>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <style is:global>
    /* Breadcrumb + byline read as typed margin notes. */
    .post-crumb {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--c-muted);
      display: flex;
      align-items: center;
      gap: 0.45rem;
    }
    .post-crumb a { color: var(--c-muted); text-decoration: none; }
    .post-byline {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      letter-spacing: 0.04em;
      color: var(--c-muted);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
    }
    .post-byline-dot { color: color-mix(in srgb, var(--c-ink) 30%, transparent); }
    .post-back { font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-accent); text-decoration: none; }
    .post-back:hover { text-decoration: underline; }

    /* Editorial CTA — a quiet sheet flagged in red pen, not a colour block. */
    .post-cta {
      border: 1px solid color-mix(in srgb, var(--c-ink) 11%, transparent);
      border-left: 3px solid var(--color-mark);
      border-radius: var(--radius-card);
      background: var(--c-surface);
      padding: 1.5rem 1.6rem 1.7rem;
    }
    .post-cta p:nth-of-type(2) { font-family: var(--font-display); font-weight: 600; letter-spacing: -0.015em; }

    /* ── The reading column ───────────────────────────────────── */
    .prose-page { font-size: 1.12rem; line-height: 1.72; }
    .prose-page > :first-child { margin-top: 0; }

    .prose-page h2 {
      font-family: var(--font-display);
      font-size: 1.6rem; font-weight: 600; letter-spacing: -0.015em;
      line-height: 1.15;
      margin-top: 2.6rem; margin-bottom: 0.6rem;
      padding-top: 1.6rem;
      border-top: 1px solid color-mix(in srgb, var(--c-ink) 10%, transparent);
    }
    .prose-page h3 {
      font-family: var(--font-display);
      font-size: 1.22rem; font-weight: 600; letter-spacing: -0.01em;
      margin-top: 1.8rem; margin-bottom: 0.4rem;
    }
    .prose-page p { margin-top: 1rem; color: color-mix(in srgb, var(--c-ink) 86%, transparent); }
    .prose-page a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 2px; text-decoration-thickness: 1px; }
    .prose-page a:hover { text-decoration-thickness: 2px; }
    .prose-page ul { list-style: disc; padding-left: 1.4rem; margin-top: 1rem; }
    .prose-page ol { list-style: decimal; padding-left: 1.4rem; margin-top: 1rem; }
    .prose-page li { margin-top: 0.4rem; color: color-mix(in srgb, var(--c-ink) 86%, transparent); }
    .prose-page li::marker { color: var(--c-muted); }
    .prose-page strong { color: var(--c-ink); font-weight: 600; }

    /* Blockquote — a passage flagged in red pen, the signature of the desk. */
    .prose-page blockquote {
      border-left: 3px solid var(--color-mark);
      padding: 0.2rem 0 0.2rem 1.25rem;
      margin: 1.5rem 0;
      font-style: italic;
      font-size: 1.18rem;
      color: color-mix(in srgb, var(--c-ink) 78%, transparent);
    }
    .prose-page blockquote p { margin-top: 0.5rem; color: inherit; }
    .prose-page blockquote p:first-child { margin-top: 0; }

    .prose-page table { width: 100%; margin-top: 1.4rem; border-collapse: collapse; font-size: 0.92rem; }
    /* On phones a wide table would push the page sideways - let it scroll instead. */
    @media (max-width: 767px) { .prose-page table { display: block; max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; } }
    .prose-page th, .prose-page td { border: 1px solid color-mix(in srgb, var(--c-ink) 12%, transparent); padding: 0.55rem 0.75rem; text-align: left; }
    .prose-page th { font-family: var(--font-mono); font-size: 0.78rem; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; background: color-mix(in srgb, var(--c-ink) 4%, transparent); }
    .prose-page code { font-family: var(--font-mono); background: color-mix(in srgb, var(--c-ink) 8%, transparent); padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.86em; }
  </style>
</Base>
