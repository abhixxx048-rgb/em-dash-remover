---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  heading: string;
  updated?: string;
}
const { title, description, heading, updated } = Astro.props;
---

<Base title={`${title} - Em Dash Remover`} description={description}>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{heading}</h1>
    {updated && <p class="mt-2 text-sm muted">Last updated: {updated}</p>}
    <article class="prose-page mt-8 space-y-5 leading-relaxed">
      <slot />
    </article>
  </main>

  <style is:global>
    .prose-page h2 { font-size: 1.25rem; font-weight: 700; margin-top: 2rem; }
    .prose-page h3 { font-size: 1.05rem; font-weight: 600; margin-top: 1.25rem; }
    .prose-page p, .prose-page li { color: color-mix(in srgb, var(--c-ink) 80%, transparent); }
    .prose-page a { color: var(--color-accent); text-decoration: underline; }
    .prose-page ul { list-style: disc; padding-left: 1.25rem; }
    .prose-page ul li { margin-top: 0.35rem; }
    .prose-page strong { color: var(--c-ink); }
  </style>
</Base>
