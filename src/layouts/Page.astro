---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  heading: string;
  eyebrow?: string;
  updated?: string;
}
const { title, description, heading, eyebrow, updated } = Astro.props;
---

<Base title={`${title} - Em Dash Remover`} description={description}>
  <main class="mx-auto max-w-2xl px-4 py-14 sm:py-20">
    <header class="page-head">
      <p class="eyebrow text-mark">{eyebrow ?? 'From the desk'}</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">{heading}</h1>
      {updated && (
        <p class="mt-4 page-updated">
          <span class="page-updated-label">Last revised</span>
          <span class="page-updated-date">{updated}</span>
        </p>
      )}
    </header>

    <hr class="rule-dash page-rule" />

    <article class="prose-page leading-relaxed">
      <slot />
    </article>
  </main>

  <style is:global>
    .page-head { max-width: 38rem; }
    .page-updated {
      display: inline-flex;
      align-items: baseline;
      gap: 0.55rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      color: var(--c-muted);
    }
    .page-updated-label {
      text-transform: uppercase;
      letter-spacing: 0.16em;
      font-size: 0.66rem;
    }
    .page-updated-date { color: var(--c-ink); }
    .page-rule { margin: 2.25rem 0 2.5rem; }
    .rule-dash.page-rule { text-align: left; }

    /* Editorial prose — Newsreader body, Fraunces section heads. */
    .prose-page > * + * { margin-top: 1.25rem; }
    .prose-page h2 {
      font-size: 1.5rem;
      line-height: 1.15;
      margin-top: 2.75rem;
      padding-top: 1.5rem;
      border-top: 1px solid color-mix(in srgb, var(--c-ink) 10%, transparent);
    }
    .prose-page h2:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
    .prose-page h3 {
      font-size: 1.12rem;
      font-weight: 600;
      margin-top: 1.75rem;
    }
    .prose-page p,
    .prose-page li {
      color: color-mix(in srgb, var(--c-ink) 82%, transparent);
      font-size: 1.08rem;
    }
    .prose-page p { line-height: 1.7; }

    /* Lead paragraph: the first paragraph reads larger, like a standfirst. */
    .prose-page > p:first-child {
      font-size: 1.22rem;
      line-height: 1.6;
      color: var(--c-ink);
    }

    .prose-page a {
      color: var(--color-accent);
      text-decoration: underline;
      text-underline-offset: 2px;
      text-decoration-thickness: 1px;
    }
    .prose-page a:hover { text-decoration-thickness: 2px; }

    /* Lists set like margin notes — em-dash markers instead of generic discs. */
    .prose-page ul { list-style: none; padding-left: 0; margin-top: 1.25rem; }
    .prose-page ul li {
      position: relative;
      padding-left: 1.5rem;
      margin-top: 0.6rem;
      line-height: 1.65;
    }
    .prose-page ul li::before {
      content: '—';
      position: absolute;
      left: 0;
      color: color-mix(in srgb, var(--color-accent) 75%, var(--c-ink));
      font-family: var(--font-display);
    }

    .prose-page strong { color: var(--c-ink); font-weight: 600; }
    .prose-page em { color: var(--c-ink); }

    /* Quiet legal/footnote paragraphs. */
    .prose-page .muted,
    .prose-page p.muted { color: var(--c-muted); font-size: 0.92rem; }
    .prose-page .text-sm { font-size: 0.92rem; }
  </style>
</Base>
