---
import '../styles/global.css';
import ConsentBanner from '../components/ConsentBanner.astro';
import { ADSENSE_PUB_ID } from '../consts';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const adsenseEnabled = ADSENSE_PUB_ID.length > 0;

const {
  title = 'Em Dash Remover — Free AI Text Cleaner',
  description = 'Free, grammar-aware em dash remover. Strip em dashes, smart quotes, invisible characters and AI tells from your text — 100% in your browser. Your text never leaves your device.',
  noindex = false,
} = Astro.props;

// Normalize the build-time path (handles /about, /about/, and /about.html forms).
const cleanPath = Astro.url.pathname
  .replace(/index\.html$/, '')
  .replace(/\.html$/, '')
  .replace(/\/$/, '');
const canonical = new URL(cleanPath || '/', Astro.site).href.replace(/\/$/, '');
const seg = cleanPath.replace(/^\//, '') || 'index';
const ogId = ['about', 'contact', 'terms', 'privacy'].includes(seg) ? seg : 'index';
const ogImage = new URL(`/open-graph/${ogId}.png`, Astro.site).href;

const nav = [
  { href: '/', label: 'Tool' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const orgGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${Astro.site}#org`,
      name: 'Em Dash Remover',
      url: Astro.site,
      logo: new URL('/favicon.svg', Astro.site).href,
    },
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      url: Astro.site,
      name: 'Em Dash Remover',
      publisher: { '@id': `${Astro.site}#org` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Google Consent Mode v2 — default DENIED, must load before any ad/analytics tag. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
      try {
        var saved = JSON.parse(localStorage.getItem('consent_v2') || 'null');
        if (saved) gtag('consent', 'update', saved);
      } catch (e) {}
    </script>

    {adsenseEnabled && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_PUB_ID}`}
        crossorigin="anonymous"></script>
    )}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Em Dash Remover" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Set theme before paint to avoid a flash. -->
    <script is:inline>
      (() => {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(orgGraph)} />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <header class="sticky top-0 z-40 border-b border-ink/8 backdrop-blur-md" style="background: color-mix(in srgb, var(--c-paper) 80%, transparent);">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2">
        <a href="/" class="flex min-h-11 items-center gap-2 font-bold">
          <span class="grid h-7 w-7 place-items-center rounded-lg bg-accent text-white">—</span>
          <span>Em Dash Remover</span>
        </a>
        <nav class="flex items-center gap-1 text-sm">
          {nav.map((n) => (
            <a href={n.href} class="inline-flex min-h-11 items-center rounded-lg px-3 muted transition hover:bg-ink/5">{n.label}</a>
          ))}
          <button id="theme-toggle" aria-label="Toggle dark mode" class="ml-1 grid h-11 w-11 place-items-center rounded-lg transition hover:bg-ink/5">
            <span class="dark:hidden">🌙</span>
            <span class="hidden dark:inline">☀️</span>
          </button>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="mt-20 border-t border-ink/8">
      <div class="mx-auto max-w-6xl px-4 py-10 text-sm muted">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <p>🔒 100% client-side — your text never leaves your browser.</p>
          <nav class="flex flex-wrap gap-x-5 gap-y-2">
            <a href="/blog" class="inline-flex min-h-11 items-center hover:text-accent">Blog</a>
            <a href="/about" class="inline-flex min-h-11 items-center hover:text-accent">About</a>
            <a href="/contact" class="inline-flex min-h-11 items-center hover:text-accent">Contact</a>
            <a href="/privacy" class="inline-flex min-h-11 items-center hover:text-accent">Privacy</a>
            <a href="/cookies" class="inline-flex min-h-11 items-center hover:text-accent">Cookies</a>
            <a href="/terms" class="inline-flex min-h-11 items-center hover:text-accent">Terms</a>
            <a href="#" data-cookie-settings class="inline-flex min-h-11 items-center hover:text-accent">Cookie settings</a>
          </nav>
        </div>
        <p class="mt-6 text-xs">© {new Date().getFullYear()} Em Dash Remover. All rights reserved.</p>
      </div>
    </footer>

    <ConsentBanner />

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
