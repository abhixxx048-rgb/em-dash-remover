---
import '../styles/global.css';
import ConsentBanner from '../components/ConsentBanner.astro';
import Analytics from '../components/Analytics.astro';
import { ADSENSE_PUB_ID } from '../consts';
import { TOOLS, CORE } from '../lib/tools-registry';

// Footer mega-grid: every tool grouped by category for sitewide internal linking.
const footerGroups: { label: string; tools: typeof TOOLS }[] = [
  { label: 'Clean & convert', tools: TOOLS.filter((t) => t.category === 'clean') },
  { label: 'Analyze & improve', tools: TOOLS.filter((t) => t.category === 'analyze') },
  { label: 'Power tools & apps', tools: TOOLS.filter((t) => t.category === 'power') },
];

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const adsenseEnabled = ADSENSE_PUB_ID.length > 0;

const {
  title = 'Em Dash Remover - Free AI Text Cleaner',
  description = 'Free, grammar-aware em dash remover. Strip em dashes, smart quotes, invisible characters and AI tells from your text - 100% in your browser. Your text never leaves your device.',
  noindex = false,
} = Astro.props;

// Normalize the build-time path (handles /about, /about/, and /about.html forms).
const cleanPath = Astro.url.pathname
  .replace(/index\.html$/, '')
  .replace(/\.html$/, '')
  .replace(/\/$/, '');
const canonical = new URL(cleanPath || '/', Astro.site).href.replace(/\/$/, '');
const seg = cleanPath.replace(/^\//, '') || 'index';
// Tool pages (/tools and /tools/<slug>) have their own OG image keyed `tools-<slug>`.
const ogId = seg === 'tools' || seg.startsWith('tools/')
  ? seg.replace(/\//g, '-')
  : ['about', 'contact', 'terms', 'privacy'].includes(seg)
    ? seg
    : 'index';
const ogImage = new URL(`/open-graph/${ogId}.png`, Astro.site).href;

// Breadcrumb trail for tool pages (Home › Tools › This tool) - helps Google show
// a breadcrumb in results and reinforces the hub-and-spoke structure.
const isToolPage = seg.startsWith('tools/');
const breadcrumb = isToolPage
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Tools', item: new URL('/tools', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: (title || '').split('-')[0].split('|')[0].trim(), item: canonical },
      ],
    }
  : null;

const nav = [
  { href: '/', label: 'Tool' },
  { href: '/tools', label: 'Tools' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const orgGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${Astro.site}#org`,
      name: 'Em Dash Remover',
      url: Astro.site,
      logo: new URL('/favicon.svg', Astro.site).href,
    },
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      url: Astro.site,
      name: 'Em Dash Remover',
      publisher: { '@id': `${Astro.site}#org` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Google Consent Mode v2 - default DENIED, must load before any ad/analytics tag. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
      try {
        var saved = JSON.parse(localStorage.getItem('consent_v2') || 'null');
        if (saved) gtag('consent', 'update', saved);
      } catch (e) {}
    </script>

    {adsenseEnabled && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_PUB_ID}`}
        crossorigin="anonymous"></script>
    )}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Em Dash Remover" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Set theme before paint to avoid a flash. -->
    <script is:inline>
      (() => {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(orgGraph)} />
    {breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}

    <Analytics />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <header class="sticky top-0 z-40 border-b border-ink/8 backdrop-blur-md" style="background: color-mix(in srgb, var(--c-paper) 80%, transparent);">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2">
        <a href="/" class="flex min-h-11 items-center gap-2 font-bold">
          <span class="grid h-7 w-7 place-items-center rounded-lg bg-accent text-white">-</span>
          <span>Em Dash Remover</span>
        </a>
        <div class="flex items-center gap-1">
          <!-- Desktop nav (hidden on mobile, where it would overflow) -->
          <nav class="hidden items-center gap-1 text-sm sm:flex">
            {nav.map((n) => (
              <a href={n.href} class="inline-flex min-h-11 items-center rounded-lg px-3 muted transition hover:bg-ink/5">{n.label}</a>
            ))}
          </nav>
          <button id="theme-toggle" aria-label="Toggle dark mode" class="grid h-11 w-11 place-items-center rounded-lg transition hover:bg-ink/5">
            <span class="dark:hidden">🌙</span>
            <span class="hidden dark:inline">☀️</span>
          </button>
          <!-- Mobile menu button -->
          <button id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" class="grid h-11 w-11 place-items-center rounded-lg transition hover:bg-ink/5 sm:hidden">
            <svg id="nav-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            <svg id="nav-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="hidden"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
          </button>
        </div>
      </div>
      <!-- Mobile nav panel -->
      <nav id="mobile-nav" hidden aria-label="Primary" class="border-t border-ink/8 px-3 py-2 sm:hidden">
        {nav.map((n) => (
          <a href={n.href} class="flex min-h-11 items-center rounded-lg px-3 text-sm muted transition hover:bg-ink/5">{n.label}</a>
        ))}
      </nav>
    </header>

    <slot />

    <footer class="mt-20 border-t border-ink/8">
      <div class="mx-auto max-w-6xl px-4 py-10 text-sm muted">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 text-xs">
          <div>
            <p class="mb-2 font-semibold text-accent">Start here</p>
            <ul class="space-y-0.5">
              <li>
                <a href={CORE.href} class="flex min-h-11 items-center gap-2 muted hover:text-accent">
                  <span aria-hidden="true">{CORE.icon}</span><span>{CORE.title}</span>
                </a>
              </li>
              <li>
                <a href="/tools" class="flex min-h-11 items-center gap-2 muted hover:text-accent">
                  <span aria-hidden="true">🧰</span><span>All tools</span>
                </a>
              </li>
            </ul>
          </div>
          {footerGroups.map((group) => (
            <div>
              <p class="mb-2 font-semibold text-accent">{group.label}</p>
              <ul class="space-y-0.5">
                {group.tools.map((tool) => (
                  <li>
                    <a href={tool.href} class="flex min-h-11 items-center gap-2 muted hover:text-accent">
                      <span aria-hidden="true">{tool.icon}</span><span>{tool.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="mt-10 flex flex-col gap-4 border-t border-ink/8 pt-8 sm:flex-row sm:items-center sm:justify-between">
          <p>🔒 100% client-side - your text never leaves your browser.</p>
          <nav class="flex flex-wrap gap-x-5 gap-y-2">
            <a href="/tools" class="inline-flex min-h-11 items-center hover:text-accent">Tools</a>
            <a href="/blog" class="inline-flex min-h-11 items-center hover:text-accent">Blog</a>
            <a href="/about" class="inline-flex min-h-11 items-center hover:text-accent">About</a>
            <a href="/contact" class="inline-flex min-h-11 items-center hover:text-accent">Contact</a>
            <a href="/privacy" class="inline-flex min-h-11 items-center hover:text-accent">Privacy</a>
            <a href="/cookies" class="inline-flex min-h-11 items-center hover:text-accent">Cookies</a>
            <a href="/terms" class="inline-flex min-h-11 items-center hover:text-accent">Terms</a>
            <a href="#" data-cookie-settings class="inline-flex min-h-11 items-center hover:text-accent">Cookie settings</a>
          </nav>
        </div>
        <p class="mt-6 text-xs">© {new Date().getFullYear()} Em Dash Remover. All rights reserved.</p>
      </div>
    </footer>

    <ConsentBanner />

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });

      // Mobile menu toggle
      (() => {
        const btn = document.getElementById('nav-toggle');
        const panel = document.getElementById('mobile-nav');
        const iOpen = document.getElementById('nav-icon-open');
        const iClose = document.getElementById('nav-icon-close');
        if (!btn || !panel) return;
        const setOpen = (open) => {
          panel.toggleAttribute('hidden', !open);
          btn.setAttribute('aria-expanded', String(open));
          btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          iOpen?.classList.toggle('hidden', open);
          iClose?.classList.toggle('hidden', !open);
        };
        btn.addEventListener('click', () => setOpen(panel.hasAttribute('hidden')));
        // Close when a link is tapped or when resizing up to desktop.
        panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
        matchMedia('(min-width: 640px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
      })();
    </script>
  </body>
</html>
