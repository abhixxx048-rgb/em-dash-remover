---
// Interactive island: a before/after diff viewer with per-change accept/reject.
// Static HTML below; behaviour is wired by the client client script, which imports
// the pure engine + jsdiff. Styling mirrors Cleaner.astro so it reads native.
---

<section id="tool" aria-label="Before and after diff viewer" class="mx-auto max-w-6xl px-4 pb-24 md:pb-0">
  <div class="card overflow-hidden">
    <!-- Toolbar: view + granularity toggles, change summary, bulk actions -->
    <div class="flex flex-wrap items-center gap-2 border-b border-ink/8 px-3 py-3 text-sm sm:gap-3 sm:px-4">
      <div class="inline-flex rounded-lg border border-ink/15 p-0.5 text-xs" role="group" aria-label="Diff view">
        <button id="view-inline" class="min-h-9 rounded-md px-3 font-medium" aria-pressed="true">Inline</button>
        <button id="view-side" class="min-h-9 rounded-md px-3 font-medium muted" aria-pressed="false">Side-by-side</button>
      </div>

      <div class="inline-flex rounded-lg border border-ink/15 p-0.5 text-xs" role="group" aria-label="Diff granularity">
        <button id="gran-word" class="min-h-9 rounded-md px-3 font-medium" aria-pressed="true">Word</button>
        <button id="gran-char" class="min-h-9 rounded-md px-3 font-medium muted" aria-pressed="false">Character</button>
      </div>

      <p id="summary" class="muted ml-auto text-xs sm:text-sm" aria-live="polite">No changes yet</p>

      <button id="accept-all" class="ctl inline-flex items-center px-3 text-xs transition hover:border-accent hover:text-accent" title="Use the cleaned version for every change">Accept all</button>
      <button id="reject-all" class="ctl inline-flex items-center px-3 text-xs transition hover:border-accent hover:text-accent" title="Keep the original for every change">Reject all</button>
    </div>

    <!-- Mobile pane switcher (inputs vs. result) -->
    <div role="tablist" aria-label="View" class="flex gap-1 px-3 pt-3 md:hidden">
      <button role="tab" id="tab-input" data-pane-tab="input" aria-selected="true" class="min-h-11 flex-1 rounded-lg px-3 text-sm font-medium">Text</button>
      <button role="tab" id="tab-output" data-pane-tab="output" aria-selected="false" class="min-h-11 flex-1 rounded-lg px-3 text-sm font-medium muted">Diff</button>
    </div>

    <!-- Inputs: original + changed -->
    <div class="grid gap-px bg-ink/8 md:grid-cols-2" data-panes>
      <!-- Original -->
      <div class="p-4" data-pane="input" style="background: var(--c-surface);">
        <div class="mb-2 flex items-center justify-between">
          <h2 class="text-xs font-semibold uppercase tracking-wide muted">Original</h2>
          <button id="copy-original" class="inline-flex min-h-11 items-center rounded-md px-3 text-sm font-medium text-accent transition hover:bg-accent-soft" title="Copy original text">Copy</button>
        </div>
        <textarea
          id="original"
          rows="10"
          aria-label="Original text"
          placeholder="Paste your original text…"
          class="w-full resize-y rounded-lg border border-ink/15 bg-transparent p-3 font-mono text-[16px] leading-relaxed outline-none focus:border-accent focus:ring-2 focus:ring-accent/20"
        ></textarea>
        <p class="mt-2 text-xs muted" id="orig-stats">0 chars</p>
      </div>

      <!-- Changed -->
      <div class="p-4" data-pane="input2" style="background: var(--c-surface);">
        <div class="mb-2 flex items-center justify-between">
          <h2 class="text-xs font-semibold uppercase tracking-wide muted">Changed</h2>
          <button id="copy-changed" class="inline-flex min-h-11 items-center rounded-md px-3 text-sm font-medium text-accent transition hover:bg-accent-soft" title="Copy changed text">Copy</button>
        </div>
        <textarea
          id="changed"
          rows="10"
          aria-label="Changed text"
          placeholder="Paste the cleaned / edited version…"
          class="w-full resize-y rounded-lg border border-ink/15 bg-transparent p-3 font-mono text-[16px] leading-relaxed outline-none focus:border-accent focus:ring-2 focus:ring-accent/20"
        ></textarea>
        <p class="mt-2 text-xs muted" id="changed-stats">0 chars</p>
      </div>
    </div>

    <!-- Change-type filter chips -->
    <div id="chips" class="flex flex-wrap gap-1.5 border-t border-ink/8 px-3 py-2 text-xs sm:px-4" hidden aria-label="Filter changes by type"></div>

    <!-- Diff surface -->
    <div class="border-t border-ink/8 p-4" data-pane="output" style="background: var(--c-surface);">
      <!-- Empty state -->
      <div id="empty" class="flex flex-col items-center justify-center gap-3 py-10 text-center">
        <p class="muted text-sm">Paste your original and changed text above - or try an example:</p>
        <div class="flex flex-wrap justify-center gap-2">
          <button data-sample="ai" class="ctl inline-flex items-center px-4 text-sm transition hover:border-accent hover:text-accent">🤖 AI paragraph</button>
          <button data-sample="quotes" class="ctl inline-flex items-center px-4 text-sm transition hover:border-accent hover:text-accent">“ Smart quotes</button>
          <button data-sample="invisible" class="ctl inline-flex items-center px-4 text-sm transition hover:border-accent hover:text-accent">👻 Invisible chars</button>
        </div>
      </div>

      <!-- Identical state -->
      <div id="identical" hidden class="flex flex-col items-center justify-center gap-2 py-10 text-center">
        <span class="text-3xl" style="color: var(--color-ok);">✓</span>
        <p class="font-semibold">No changes - your text was already clean.</p>
        <p class="muted text-sm">The original and changed text are identical.</p>
      </div>

      <!-- Inline diff -->
      <div
        id="diff-inline"
        hidden
        aria-label="Inline diff"
        class="max-h-[60vh] w-full overflow-auto whitespace-pre-wrap rounded-lg border border-ink/15 p-3 font-mono text-[16px] leading-relaxed"
        style="background: var(--c-paper);"></div>

      <!-- Side-by-side diff -->
      <div id="diff-side" hidden aria-label="Side-by-side diff" class="max-h-[60vh] overflow-auto rounded-lg border border-ink/15" style="background: var(--c-paper);">
        <div class="grid grid-cols-2 divide-x divide-ink/10 font-mono text-[15px] leading-relaxed">
          <div id="side-left" class="overflow-x-auto whitespace-pre-wrap p-3"></div>
          <div id="side-right" class="overflow-x-auto whitespace-pre-wrap p-3"></div>
        </div>
      </div>
    </div>

    <!-- Result actions -->
    <div class="flex flex-wrap items-center gap-2 border-t border-ink/8 px-4 py-4 text-sm">
      <p id="meter" class="muted text-xs sm:text-sm" aria-live="polite">0 of 0 changes reviewed</p>
      <div class="ml-auto flex items-center gap-1.5">
        <button id="export-md" aria-label="Download diff as Markdown" class="grid h-11 w-11 place-items-center rounded-md text-base muted transition hover:bg-ink/5" title="Download diff as Markdown">⌥</button>
        <button id="download" aria-label="Download final result as .txt" class="grid h-11 w-11 place-items-center rounded-md text-base muted transition hover:bg-ink/5" title="Download result .txt">⬇</button>
        <button id="clear" class="ctl inline-flex items-center px-3 transition hover:bg-ink/5">↺ Clear</button>
        <button id="copy" class="inline-flex min-h-11 items-center rounded-md bg-accent px-4 text-sm font-semibold text-white transition hover:opacity-90 disabled:opacity-40" disabled>Copy result</button>
      </div>
    </div>
  </div>

  <p class="mt-3 text-center text-xs muted">
    🔒 Runs entirely in your browser - open DevTools → Network and you'll see zero requests. Your text is never uploaded.
  </p>
</section>

<div id="toast" role="status" aria-live="polite"
  class="pointer-events-none fixed bottom-24 left-1/2 z-50 -translate-x-1/2 rounded-lg px-4 py-2 text-sm opacity-0 shadow-lg transition-opacity md:bottom-5"
  style="background: var(--c-ink); color: var(--c-paper);"></div>

<script>
  import { diffWords, diffWordsWithSpace, diffChars } from 'diff';
  import {
    partsToSegments,
    summarize,
    mergeResult,
    kindsPresent,
    kindLabel,
    explainChange,
    visualizeInvisibles,
    escapeHtml,
    toMarkdown,
    type Segment,
    type ChangeKind,
  } from '../../lib/tools/before-after-diff-viewer';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const original = $<HTMLTextAreaElement>('original');
  const changed = $<HTMLTextAreaElement>('changed');
  const inlineEl = $<HTMLDivElement>('diff-inline');
  const sideLeft = $<HTMLDivElement>('side-left');
  const sideRight = $<HTMLDivElement>('side-right');

  // --- example data: a messy "before" and its cleaned "after"
  const SAMPLES: Record<string, { before: string; after: string }> = {
    ai: {
      before: 'It’s not just about the numbers - it’s about the story they tell. We’ve leveraged a robust strategy to unlock our potential…',
      after: "It's not just about the numbers, it's about the story they tell. We've leveraged a robust strategy to unlock our potential...",
    },
    quotes: {
      before: '“Let’s be honest,” she said - “most people get this wrong.”',
      after: '"Let\'s be honest," she said, "most people get this wrong."',
    },
    invisible: {
      before: 'This sentence​looks normal​ but hides zero‑width characters.',
      after: 'This sentence looks normal but hides zero-width characters.',
    },
  };

  // --- toast (copied from Cleaner.astro)
  let toastTimer = 0;
  function toast(msg: string) {
    const t = $<HTMLDivElement>('toast');
    t.textContent = msg;
    t.style.opacity = '1';
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (t.style.opacity = '0'), 2200);
  }

  // --- persisted UI prefs
  type Gran = 'word' | 'char';
  type ViewMode = 'inline' | 'side';
  let gran: Gran = (localStorage.getItem('diff-gran') as Gran) || 'word';
  let view: ViewMode = (localStorage.getItem('diff-view') as ViewMode) || 'inline';

  // --- state
  let segments: Segment[] = [];
  let touched = new Set<number>();              // change indexes the user acted on
  let activeFilter: ChangeKind | 'all' = 'all'; // chip filter

  function computeSegments(before: string, after: string): Segment[] {
    if (before === after) return [];
    // diffWordsWithSpace preserves whitespace → lossless reassembly (word mode).
    const parts =
      gran === 'char'
        ? diffChars(before, after)
        : diffWordsWithSpace(before, after);
    return partsToSegments(parts);
  }

  // Render one change/unchanged segment to an inline <ins>/<del> fragment.
  function inlineHtml(seg: Segment): string {
    if (seg.type === 'unchanged') return escapeHtml(seg.before);
    const dimmed = activeFilter !== 'all' && seg.kind !== activeFilter ? ' opacity-40' : '';
    const why = escapeHtml(explainChange(seg.kind, seg.before, seg.after));
    const acc = seg.decision === 'accepted';
    let html = `<span class="seg group/seg relative inline${dimmed}" data-seg="${seg.index}" title="${why}">`;
    // Deletion (original) - shown struck unless accepted hides it.
    if (seg.before) {
      const visB = escapeHtml(visualizeInvisibles(seg.before));
      html += `<del class="diff-del${acc ? '' : ' is-kept'}" aria-label="deleted">${visB || '∅'}</del>`;
    }
    // Insertion (cleaned) - shown unless rejected.
    if (seg.after) {
      const visA = escapeHtml(visualizeInvisibles(seg.after));
      html += `<ins class="diff-ins${acc ? '' : ' is-dropped'}" aria-label="inserted">${visA}</ins>`;
    }
    // Per-change controls (keep original / use cleaned).
    html +=
      `<span class="seg-ctl ml-0.5 inline-flex gap-0.5 align-middle" role="group" aria-label="${why}">` +
      `<button type="button" data-act="reject" data-i="${seg.index}" title="Keep original" aria-pressed="${!acc}" class="seg-btn">↩</button>` +
      `<button type="button" data-act="accept" data-i="${seg.index}" title="Use cleaned" aria-pressed="${acc}" class="seg-btn">✓</button>` +
      `</span>`;
    html += '</span>';
    return html;
  }

  function renderInline() {
    inlineEl.innerHTML = segments.map(inlineHtml).join('');
  }

  // Side-by-side: split on lines, left = original (rejected-aware), right = result.
  function renderSide() {
    const origLines = (original.value || '').split('\n');
    const resultLines = mergeResult(segments).split('\n');
    const rows = Math.max(origLines.length, resultLines.length);
    let left = '';
    let right = '';
    for (let i = 0; i < rows; i++) {
      const gutter = `<span class="muted select-none mr-3 inline-block w-8 text-right">${i + 1}</span>`;
      const l = origLines[i];
      const r = resultLines[i];
      const changedRow = l !== r;
      const lCls = changedRow && l !== undefined ? ' class="diff-row-del rounded px-1"' : '';
      const rCls = changedRow && r !== undefined ? ' class="diff-row-ins rounded px-1"' : '';
      left += `<div${lCls}>${gutter}${escapeHtml(visualizeInvisibles(l ?? ''))}</div>`;
      right += `<div${rCls}>${gutter}${escapeHtml(visualizeInvisibles(r ?? ''))}</div>`;
    }
    sideLeft.innerHTML = left;
    sideRight.innerHTML = right;
  }

  function renderChips() {
    const chips = $<HTMLDivElement>('chips');
    const kinds = kindsPresent(segments);
    if (kinds.length <= 1) { chips.hidden = true; chips.innerHTML = ''; return; }
    chips.hidden = false;
    const mk = (key: ChangeKind | 'all', label: string) => {
      const active = activeFilter === key;
      return `<button type="button" data-chip="${key}" aria-pressed="${active}" class="ctl inline-flex items-center px-3 text-xs ${active ? 'border-accent text-accent' : ''}" ${active ? 'style="background: var(--c-accent-soft);"' : ''}>${label}</button>`;
    };
    chips.innerHTML =
      mk('all', 'All') + kinds.map((k) => mk(k, kindLabel(k))).join('');
  }

  function updateMeterAndSummary() {
    const sum = summarize(segments);
    $<HTMLParagraphElement>('summary').textContent = sum.identical
      ? 'No changes'
      : `${sum.changes} change${sum.changes === 1 ? '' : 's'} · +${sum.insertions + sum.replacements} −${sum.deletions + sum.replacements}`;
    const reviewed = [...touched].filter((i) => segments[i]?.type === 'change').length;
    $<HTMLParagraphElement>('meter').textContent =
      `${reviewed} of ${sum.changes} change${sum.changes === 1 ? '' : 's'} reviewed`;
  }

  function showState(which: 'empty' | 'identical' | 'diff') {
    $<HTMLDivElement>('empty').hidden = which !== 'empty';
    $<HTMLDivElement>('identical').hidden = which !== 'identical';
    inlineEl.hidden = !(which === 'diff' && view === 'inline');
    $<HTMLDivElement>('diff-side').hidden = !(which === 'diff' && view === 'side');
  }

  function render() {
    if (view === 'inline') renderInline();
    else renderSide();
    updateMeterAndSummary();
  }

  // --- full recompute (debounced via rAF on input)
  function run() {
    const before = original.value;
    const after = changed.value;
    $<HTMLParagraphElement>('orig-stats').textContent = `${before.length} chars`;
    $<HTMLParagraphElement>('changed-stats').textContent = `${after.length} chars`;

    if (!before && !after) {
      segments = []; touched = new Set(); activeFilter = 'all';
      $<HTMLDivElement>('chips').hidden = true;
      showState('empty');
      $<HTMLButtonElement>('copy').disabled = true;
      $<HTMLParagraphElement>('summary').textContent = 'No changes yet';
      $<HTMLParagraphElement>('meter').textContent = '0 of 0 changes reviewed';
      return;
    }

    segments = computeSegments(before, after);
    touched = new Set();
    if (segments.length === 0 || summarize(segments).identical) {
      $<HTMLDivElement>('chips').hidden = true;
      showState('identical');
      $<HTMLButtonElement>('copy').disabled = false;
      $<HTMLParagraphElement>('summary').textContent = 'No changes';
      $<HTMLParagraphElement>('meter').textContent = '0 of 0 changes reviewed';
      return;
    }

    showState('diff');
    $<HTMLButtonElement>('copy').disabled = false;
    renderChips();
    render();
  }

  // debounced re-diff (rAF, like Cleaner.astro)
  let raf = 0;
  const schedule = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(run); };
  original.addEventListener('input', schedule);
  changed.addEventListener('input', schedule);

  // --- per-change accept/reject (event delegation on the inline surface)
  function setDecision(i: number, decision: 'accepted' | 'rejected') {
    const seg = segments[i];
    if (!seg || seg.type !== 'change') return;
    seg.decision = decision;
    touched.add(i);
    render();
    toast(decision === 'accepted' ? 'Using cleaned version' : 'Kept original');
  }
  inlineEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-act]');
    if (!btn) return;
    setDecision(Number(btn.dataset.i), btn.dataset.act === 'accept' ? 'accepted' : 'rejected');
  });

  // --- bulk actions
  function bulk(decision: 'accepted' | 'rejected') {
    for (const s of segments) if (s.type === 'change') { s.decision = decision; touched.add(s.index); }
    render();
    toast(decision === 'accepted' ? 'Accepted all changes' : 'Rejected all changes');
  }
  $('accept-all').addEventListener('click', () => bulk('accepted'));
  $('reject-all').addEventListener('click', () => bulk('rejected'));

  // --- chip filter
  $('chips').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-chip]');
    if (!btn) return;
    activeFilter = btn.dataset.chip as ChangeKind | 'all';
    renderChips();
    render();
  });

  // --- view + granularity toggles
  function applyToggle(group: { id: string; on: boolean }[]) {
    for (const g of group) {
      const el = $<HTMLButtonElement>(g.id);
      el.setAttribute('aria-pressed', String(g.on));
      el.classList.toggle('muted', !g.on);
      el.style.background = g.on ? 'var(--c-accent-soft)' : '';
    }
  }
  function setView(v: ViewMode) {
    view = v; localStorage.setItem('diff-view', v);
    applyToggle([{ id: 'view-inline', on: v === 'inline' }, { id: 'view-side', on: v === 'side' }]);
    if (!$<HTMLDivElement>('empty').hidden || !$<HTMLDivElement>('identical').hidden) return;
    showState('diff'); render();
  }
  function setGran(g: Gran) {
    gran = g; localStorage.setItem('diff-gran', g);
    applyToggle([{ id: 'gran-word', on: g === 'word' }, { id: 'gran-char', on: g === 'char' }]);
    run(); // granularity change needs a full re-diff
  }
  $('view-inline').addEventListener('click', () => setView('inline'));
  $('view-side').addEventListener('click', () => setView('side'));
  $('gran-word').addEventListener('click', () => setGran('word'));
  $('gran-char').addEventListener('click', () => setGran('char'));

  // --- samples
  document.querySelectorAll<HTMLButtonElement>('[data-sample]').forEach((b) =>
    b.addEventListener('click', () => {
      const s = SAMPLES[b.dataset.sample!];
      original.value = s.before; changed.value = s.after;
      run(); setPane('output');
    }));

  // --- mobile pane switcher
  function setPane(name: 'input' | 'output') {
    const inputs = ['input', 'input2'];
    document.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => {
      const show = name === 'input' ? inputs.includes(p.dataset.pane!) : p.dataset.pane === 'output';
      p.classList.toggle('max-md:hidden', !show);
    });
    document.querySelectorAll<HTMLButtonElement>('[data-pane-tab]').forEach((t) => {
      const active = t.dataset.paneTab === name;
      t.setAttribute('aria-selected', String(active));
      t.classList.toggle('muted', !active);
      t.style.background = active ? 'var(--c-accent-soft)' : '';
      t.style.color = active ? 'var(--color-accent)' : '';
    });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-pane-tab]').forEach((t) =>
    t.addEventListener('click', () => setPane(t.dataset.paneTab as 'input' | 'output')));

  // --- copy / download / clear
  async function copyText(text: string, label: string) {
    if (!text) return;
    try { await navigator.clipboard.writeText(text); toast(label); }
    catch { toast('Copy failed - select and copy manually'); }
  }
  $('copy').addEventListener('click', () => copyText(mergeResult(segments), 'Result copied to clipboard'));
  $('copy-original').addEventListener('click', () => copyText(original.value, 'Original copied'));
  $('copy-changed').addEventListener('click', () => copyText(changed.value, 'Changed copied'));

  function downloadFile(text: string, name: string, type = 'text/plain') {
    const blob = new Blob([text], { type });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = name; a.click();
    URL.revokeObjectURL(url);
  }
  $('download').addEventListener('click', () => { downloadFile(mergeResult(segments), 'result.txt'); toast('Downloaded result.txt'); });
  $('export-md').addEventListener('click', () => { downloadFile(toMarkdown(segments), 'diff.md', 'text/markdown'); toast('Downloaded diff.md'); });

  $('clear').addEventListener('click', () => {
    original.value = ''; changed.value = '';
    run(); original.focus(); setPane('input'); toast('Cleared');
  });

  // --- keyboard: Cmd/Ctrl+Enter recomputes; a/r/j/k for power review
  let cursor = -1; // index into change segments for j/k navigation
  function changeIndexes() { return segments.filter((s) => s.type === 'change').map((s) => s.index); }
  function focusCursor() {
    const idxs = changeIndexes();
    if (!idxs.length) return;
    if (cursor < 0) cursor = 0;
    cursor = Math.max(0, Math.min(cursor, idxs.length - 1));
    const segIndex = idxs[cursor];
    const el = inlineEl.querySelector<HTMLElement>(`[data-seg="${segIndex}"]`);
    el?.scrollIntoView({ block: 'center', behavior: 'smooth' });
    el?.classList.add('seg-active');
    inlineEl.querySelectorAll('.seg-active').forEach((n) => { if (n !== el) n.classList.remove('seg-active'); });
  }
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') { e.preventDefault(); run(); return; }
    // Skip single-key shortcuts while typing in a textarea/input.
    const tag = (e.target as HTMLElement).tagName;
    if (tag === 'TEXTAREA' || tag === 'INPUT' || e.metaKey || e.ctrlKey || e.altKey) return;
    if (view !== 'inline' || !changeIndexes().length) return;
    const idxs = changeIndexes();
    if (e.key === 'j') { e.preventDefault(); cursor++; focusCursor(); }
    else if (e.key === 'k') { e.preventDefault(); cursor--; focusCursor(); }
    else if (e.key === 'a' && cursor >= 0) { e.preventDefault(); setDecision(idxs[cursor], 'accepted'); focusCursor(); }
    else if (e.key === 'r' && cursor >= 0) { e.preventDefault(); setDecision(idxs[cursor], 'rejected'); focusCursor(); }
  });

  // --- init
  applyToggle([{ id: 'view-inline', on: view === 'inline' }, { id: 'view-side', on: view === 'side' }]);
  applyToggle([{ id: 'gran-word', on: gran === 'word' }, { id: 'gran-char', on: gran === 'char' }]);
  setPane('input');
  run();
</script>

<style is:global>
  /* Rejected insertion / accepted deletion get dimmed so the surviving choice
     is obvious without relying on colour alone. */
  #diff-inline ins.is-dropped { opacity: 0.35; text-decoration: line-through underline; }
  #diff-inline del.is-kept { opacity: 1; text-decoration: none; background: var(--c-accent-soft); color: var(--c-ink); }
  /* Per-change buttons - small but reachable; full visibility on hover/focus. */
  #diff-inline .seg-btn {
    min-width: 1.6em; min-height: 1.6em; border-radius: 6px; font-size: 0.85em;
    border: 1px solid color-mix(in srgb, var(--c-ink) 16%, transparent);
    background: var(--c-surface); color: var(--c-muted); cursor: pointer; line-height: 1;
    opacity: 0; transition: opacity .15s;
  }
  #diff-inline .seg:hover .seg-btn,
  #diff-inline .seg:focus-within .seg-btn,
  #diff-inline .seg.seg-active .seg-btn { opacity: 1; }
  #diff-inline .seg-btn[aria-pressed="true"] { border-color: var(--color-accent); color: var(--color-accent); }
