---
// Interactive island for the Invisible / Watermark Character Inspector.
// Static HTML below; the client script imports the pure engine and wires behavior.
// Visual language mirrors Cleaner.astro (toolbar, panes, toast, sticky bar).
---

<section id="tool" aria-label="Invisible character inspector" class="mx-auto max-w-6xl px-4 pb-24 md:pb-0">
  <div class="card overflow-hidden">
    <!-- Toolbar -->
    <div class="flex flex-wrap items-center gap-2 border-b border-ink/8 px-3 py-3 text-sm sm:gap-3 sm:px-4">
      <span class="font-medium">Show invisibles</span>

      <details class="group relative w-full sm:w-auto">
        <summary class="ctl flex w-full cursor-pointer list-none items-center gap-1.5 px-3 marker:hidden sm:w-auto">
          ⚙ Detection options <span class="ml-auto transition group-open:rotate-180 sm:ml-0">▾</span>
        </summary>
        <div class="card mt-2 w-full space-y-1 p-2 text-sm sm:absolute sm:left-0 sm:top-full sm:z-20 sm:w-64 sm:p-3 sm:shadow-lg">
          <label class="flex min-h-11 items-center gap-3 rounded-lg px-2 hover:bg-ink/5"><input type="checkbox" id="opt-tabs" class="h-5 w-5" /> Show tabs &amp; carriage returns</label>
          <label class="flex min-h-11 items-center gap-3 rounded-lg px-2 hover:bg-ink/5"><input type="checkbox" id="opt-controls" class="h-5 w-5" /> Show control characters</label>
          <label class="flex min-h-11 items-center gap-3 rounded-lg px-2 hover:bg-ink/5"><input type="checkbox" id="opt-pua" class="h-5 w-5" /> Show Private Use Area</label>
        </div>
      </details>

      <button id="reset" class="ctl ml-auto inline-flex items-center justify-center px-3 transition hover:bg-ink/5">↺ Clear</button>
    </div>

    <!-- Mobile pane switcher -->
    <div role="tablist" aria-label="View" class="flex gap-1 px-3 pt-3 md:hidden">
      <button role="tab" id="tab-input" data-pane-tab="input" aria-selected="true" class="min-h-11 flex-1 rounded-lg px-3 text-sm font-medium">Paste</button>
      <button role="tab" id="tab-output" data-pane-tab="output" aria-selected="false" class="min-h-11 flex-1 rounded-lg px-3 text-sm font-medium muted">Inspect</button>
    </div>

    <!-- Panes -->
    <div class="grid gap-px bg-ink/8 md:grid-cols-2" data-panes>
      <!-- Input -->
      <div class="bg-surface p-4" data-pane="input" style="background: var(--c-surface);">
        <div class="mb-2 flex items-center justify-between">
          <h2 class="text-xs font-semibold uppercase tracking-wide muted">Paste your text</h2>
          <button id="paste" class="inline-flex min-h-11 items-center rounded-md px-3 text-sm font-medium text-accent transition hover:bg-accent-soft">📋 Paste</button>
        </div>
        <div class="relative">
          <textarea
            id="input"
            rows="14"
            aria-label="Text to inspect for invisible characters"
            class="w-full resize-y rounded-lg border border-ink/15 bg-transparent p-3 font-mono text-[16px] leading-relaxed outline-none focus:border-accent focus:ring-2 focus:ring-accent/20"
          ></textarea>
          <!-- Empty state -->
          <div id="empty" class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-3 p-4 text-center">
            <p class="muted text-sm">Paste any text to reveal hidden Unicode - or try an example:</p>
            <div class="pointer-events-auto flex flex-wrap justify-center gap-2">
              <button data-sample="gpt" class="ctl inline-flex items-center px-4 text-sm transition hover:border-accent hover:text-accent">🤖 GPT spacing (U+202F)</button>
              <button data-sample="zwsp" class="ctl inline-flex items-center px-4 text-sm transition hover:border-accent hover:text-accent">👻 Zero-width watermark</button>
              <button data-sample="trojan" class="ctl inline-flex items-center px-4 text-sm transition hover:border-accent hover:text-accent">⚠ Trojan-source (bidi)</button>
              <button data-sample="clean" class="ctl inline-flex items-center px-4 text-sm transition hover:border-accent hover:text-accent">✓ Clean text</button>
            </div>
            <p class="muted text-xs">🔒 Nothing leaves your browser.</p>
          </div>
        </div>
        <p class="mt-2 text-xs muted" id="in-stats">0 chars scanned</p>
      </div>

      <!-- Output -->
      <div class="bg-surface p-4" data-pane="output" style="background: var(--c-surface);">
        <div class="mb-2 flex items-center justify-between">
          <div class="inline-flex rounded-lg border border-ink/15 p-0.5 text-xs">
            <button id="view-show" class="min-h-9 rounded-md px-3 font-medium">Show invisibles</button>
            <button id="view-clean" class="min-h-9 rounded-md px-3 font-medium muted">Cleaned</button>
          </div>
          <div class="flex items-center gap-1.5">
            <button id="download" aria-label="Download cleaned text as .txt" class="grid h-11 w-11 place-items-center rounded-md text-base muted transition hover:bg-ink/5" title="Download cleaned .txt">⬇</button>
            <button id="copy" class="inline-flex min-h-11 items-center rounded-md bg-accent px-4 text-sm font-semibold text-white transition hover:opacity-90 disabled:opacity-40" disabled>Copy clean</button>
          </div>
        </div>

        <!-- Inline highlighted render (read-only, derived view). DOM built in JS. -->
        <div id="render" aria-label="Text with invisible characters highlighted" tabindex="0"
          class="h-[calc(14*1.625em+1.5rem)] w-full overflow-auto whitespace-pre-wrap break-words rounded-lg border border-ink/15 p-3 font-mono text-[16px] leading-relaxed"
          style="background: var(--c-paper);"></div>

        <!-- Cleaned plain-text output (hidden until "Cleaned" view). -->
        <textarea id="output" rows="14" readonly aria-label="Cleaned text" hidden
          class="w-full resize-y rounded-lg border border-ink/15 p-3 font-mono text-[16px] leading-relaxed outline-none"
          style="background: var(--c-paper);"></textarea>
      </div>
    </div>

    <!-- Score + summary -->
    <div class="grid items-center gap-5 border-t border-ink/8 px-4 py-4 sm:grid-cols-[auto_1fr]">
      <div class="flex items-center gap-4">
        <div class="relative h-20 w-20 shrink-0">
          <svg viewBox="0 0 80 80" class="h-20 w-20 -rotate-90">
            <circle class="ring-track" cx="40" cy="40" r="34" fill="none" stroke-width="8" />
            <circle id="ring" cx="40" cy="40" r="34" fill="none" stroke-width="8" stroke-linecap="round"
              stroke="var(--color-ok)" stroke-dasharray="213.6" stroke-dashoffset="0"
              style="transition: stroke-dashoffset .6s ease, stroke .4s ease;" />
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span id="score-num" class="text-xl font-bold leading-none" data-v="100">-</span>
            <span class="text-[9px] muted">/ 100</span>
          </div>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide muted">Hygiene score</p>
          <p id="band" class="text-sm font-semibold">Paste text to scan</p>
          <p id="found" class="mt-0.5 text-xs" aria-live="polite"></p>
          <button id="report" class="mt-1 text-xs font-medium text-accent hover:underline" hidden>📋 Copy report</button>
        </div>
      </div>
      <div>
        <span class="text-xs font-semibold uppercase tracking-wide muted">What we found</span>
        <ul id="counts" class="mt-1.5 flex flex-wrap gap-1.5 text-xs" aria-live="polite"></ul>
      </div>
    </div>

    <!-- Security banner (shown only when a risk-class char is present). -->
    <div id="risk-banner" hidden class="border-t border-ink/8 px-4 py-3 text-sm font-medium"
      style="background: color-mix(in srgb, var(--color-bad) 12%, transparent); color: var(--color-bad);">
      ⚠ Security risk: this text contains bidirectional or tag characters that can hide or reorder text (Trojan Source / ASCII smuggling). Review before trusting it.
    </div>
  </div>

  <p class="mt-3 text-center text-xs muted">
    🔒 Runs entirely in your browser - open DevTools → Network and you'll see zero requests. Works offline.
  </p>
</section>

<div id="toast" role="status" aria-live="polite"
  class="pointer-events-none fixed bottom-24 left-1/2 z-50 -translate-x-1/2 rounded-lg bg-ink px-4 py-2 text-sm text-paper opacity-0 shadow-lg transition-opacity md:bottom-5"
  style="background: var(--c-ink); color: var(--c-paper);"></div>

<!-- Sticky thumb-reachable action bar (mobile only) -->
<div class="fixed inset-x-0 bottom-0 z-40 flex gap-2 border-t border-ink/8 px-3 pt-2 md:hidden"
  style="background: color-mix(in srgb, var(--c-paper) 92%, transparent); backdrop-filter: blur(8px); padding-bottom: calc(0.5rem + env(safe-area-inset-bottom));">
  <button id="paste-bar" class="min-h-12 flex-1 rounded-xl border border-ink/15 font-semibold">📋 Paste</button>
  <button id="clear-bar" aria-label="Clear" class="min-h-12 rounded-xl border border-ink/15 px-5 font-semibold">↺</button>
  <button id="copy-bar" class="min-h-12 flex-1 rounded-xl bg-accent font-semibold text-white disabled:opacity-40" disabled>Copy clean</button>
</div>

<!-- Chip styling for the inline render. Uses tokens so it works in both themes. -->
<style is:global>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.15em;
    padding: 0 0.3em;
    margin: 0 0.05em;
    border-radius: 5px;
    font-size: 0.72em;
    line-height: 1.4;
    font-weight: 700;
    vertical-align: baseline;
    border: 1px solid transparent;
    cursor: help;
    white-space: nowrap;
  }
  .chip:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 1px; }
  /* Severity: paired with the U+XXXX text + icon, never color alone. */
  .chip--benign { background: color-mix(in srgb, var(--c-ink) 10%, transparent); color: var(--c-ink); border-color: color-mix(in srgb, var(--c-ink) 22%, transparent); }
  .chip--tell { background: color-mix(in srgb, var(--color-warn) 18%, transparent); color: var(--color-warn); border-color: color-mix(in srgb, var(--color-warn) 45%, transparent); }
  .chip--risk { background: color-mix(in srgb, var(--color-bad) 16%, transparent); color: var(--color-bad); border-color: color-mix(in srgb, var(--color-bad) 50%, transparent); }
  .dark .chip--tell { color: #fbbf24; }
  .dark .chip--risk { color: #fda4af; }
  .count-pill { border-radius: 9999px; padding: 0.1rem 0.5rem; }
</style>

<script>
  import {
    inspect,
    tokenize,
    cleanText,
    buildReport,
    formatCp,
    DEFAULT_CLEAN,
    CATEGORY_ICON,
    type InspectOptions,
    type Severity,
  } from '../../lib/tools/invisible-watermark-character-inspector';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const input = $<HTMLTextAreaElement>('input');
  const output = $<HTMLTextAreaElement>('output');
  const render = $<HTMLDivElement>('render');

  // --- Example payloads. Built programmatically so the invisible chars survive
  // editing/copy-paste of this source file (escapes, not literal glyphs).
  const ZWSP = '​';
  const NNBSP = ' ';
  const RLO = '‮';
  const PDF = '‬';
  const SAMPLES: Record<string, string> = {
    gpt:
      `Here${NNBSP}is a quick summary of the report. The results${NNBSP}were strong, ` +
      `and the team${NNBSP}delivered ahead of schedule${NNBSP}- a great outcome for everyone.`,
    zwsp:
      `This paragraph looks${ZWSP} completely normal,${ZWSP} but it is quietly seeded ` +
      `with${ZWSP} zero-width spaces${ZWSP} between several words.​ You cannot see them, ` +
      `yet they are there.`,
    trojan:
      `Transfer the funds to account ${RLO}1234${PDF} (review the highlighted text carefully). ` +
      `The right-to-left override above can make text read in a different order than it is stored.`,
    clean:
      `This is a perfectly ordinary paragraph of text. It contains only normal spaces, ` +
      `letters, and punctuation - nothing hidden, nothing to strip.`,
  };

  // --- options
  function readOptions(): InspectOptions {
    return {
      showTabs: $<HTMLInputElement>('opt-tabs').checked,
      showControls: $<HTMLInputElement>('opt-controls').checked,
      includePua: $<HTMLInputElement>('opt-pua').checked,
    };
  }

  // --- persistence (preferences only - never the text, for privacy)
  const OPT_IDS = ['opt-tabs', 'opt-controls', 'opt-pua'];
  function saveOpts() {
    const s: Record<string, boolean> = {};
    for (const id of OPT_IDS) s[id] = $<HTMLInputElement>(id).checked;
    localStorage.setItem('iwci-opts', JSON.stringify(s));
  }
  function loadOpts() {
    try {
      const s = JSON.parse(localStorage.getItem('iwci-opts') || '{}');
      for (const id of OPT_IDS) if (id in s) $<HTMLInputElement>(id).checked = s[id];
    } catch {}
  }

  // --- toast
  let toastTimer = 0;
  function toast(msg: string) {
    const t = $<HTMLDivElement>('toast');
    t.textContent = msg;
    t.style.opacity = '1';
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (t.style.opacity = '0'), 2200);
  }

  // --- count-up
  function animateCount(el: HTMLElement, to: number, dur = 600) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = String(to);
      el.dataset.v = String(to);
      return;
    }
    const from = parseInt(el.dataset.v || '0', 10);
    const t0 = performance.now();
    const tick = (t: number) => {
      const p = Math.min(1, (t - t0) / dur);
      const e = 1 - Math.pow(1 - p, 3);
      el.textContent = String(Math.round(from + (to - from) * e));
      if (p < 1) requestAnimationFrame(tick);
      else el.dataset.v = String(to);
    };
    requestAnimationFrame(tick);
  }

  // --- inline render. Build DOM (never innerHTML with user text → XSS-safe).
  function renderInline(src: string, opts: InspectOptions) {
    render.replaceChildren();
    const tokens = tokenize(src, opts);
    for (const tok of tokens) {
      if (tok.kind === 'text') {
        render.appendChild(document.createTextNode(tok.value));
      } else {
        const chip = document.createElement('span');
        chip.className = `chip chip--${tok.info.severity}`;
        chip.tabIndex = 0;
        const cpStr = formatCp(tok.cp);
        // Icon + visible code point text (not color-only).
        chip.textContent = `${CATEGORY_ICON[tok.info.category]} ${cpStr}`;
        const label = `${tok.info.name}, ${cpStr}, ${tok.info.category}, at position ${tok.index}`;
        chip.setAttribute('aria-label', label);
        chip.title = `${cpStr} ${tok.info.name}\n${tok.info.note}`;
        render.appendChild(chip);
      }
    }
  }

  const RING = 213.6;
  let lastReport = '';
  let cleanedText = '';

  function severityBand(sev: Severity | null): { score: number; label: string; color: string } {
    if (sev === null) return { score: 100, label: '✓ Looks clean', color: 'var(--color-ok)' };
    if (sev === 'risk') return { score: 25, label: '⚠ Security risk found', color: 'var(--color-bad)' };
    if (sev === 'tell') return { score: 65, label: 'Likely AI / spacing tells', color: 'var(--color-warn)' };
    return { score: 80, label: 'Minor artifacts found', color: 'var(--color-warn)' };
  }

  function run() {
    const src = input.value;
    const opts = readOptions();
    $<HTMLDivElement>('empty').hidden = src.length > 0;

    const result = inspect(src, opts);

    // Stats line.
    $<HTMLParagraphElement>('in-stats').textContent =
      `${result.scanned} chars scanned · ${result.total} hidden`;

    // Inline highlighted render.
    renderInline(src, opts);

    // Cleaned text (uses sensible default category cleaning).
    const cleaned = cleanText(src, { ...DEFAULT_CLEAN, ...opts });
    cleanedText = cleaned.text;
    output.value = cleanedText;
    const hasClean = src.length > 0;
    $<HTMLButtonElement>('copy').disabled = !hasClean;
    ($('copy-bar') as HTMLButtonElement).disabled = !hasClean;

    // Score ring + band.
    const scoreNum = $<HTMLSpanElement>('score-num');
    const ring = document.getElementById('ring') as unknown as SVGCircleElement;
    if (!src.trim()) {
      scoreNum.textContent = '-';
      scoreNum.dataset.v = '100';
      ring.style.strokeDashoffset = '0';
      ring.style.stroke = 'var(--color-ok)';
      $<HTMLParagraphElement>('band').textContent = 'Paste text to scan';
      $<HTMLParagraphElement>('found').textContent = '';
      $<HTMLButtonElement>('report').hidden = true;
    } else {
      const band = severityBand(result.topSeverity);
      animateCount(scoreNum, band.score);
      ring.style.strokeDashoffset = String(RING * (1 - band.score / 100));
      ring.style.stroke = band.color;
      $<HTMLParagraphElement>('band').textContent = band.label;
      const found = $<HTMLParagraphElement>('found');
      if (result.total === 0) {
        found.textContent = 'No hidden characters detected.';
        found.style.color = 'var(--color-ok)';
      } else {
        found.textContent = `Found ${result.total} hidden character${result.total === 1 ? '' : 's'}.`;
        found.style.color = 'var(--c-muted)';
      }
      $<HTMLButtonElement>('report').hidden = false;
    }

    // Count chips legend.
    const countsEl = $<HTMLUListElement>('counts');
    countsEl.replaceChildren();
    if (!src.trim()) {
      const li = document.createElement('li');
      li.className = 'muted';
      li.textContent = 'Paste text to scan.';
      countsEl.appendChild(li);
    } else if (result.rows.length === 0) {
      const li = document.createElement('li');
      li.className = 'count-pill';
      li.style.background = 'color-mix(in srgb, var(--color-ok) 16%, transparent)';
      li.style.color = 'var(--color-ok)';
      li.textContent = '✓ No hidden characters - your text is clean';
      countsEl.appendChild(li);
    } else {
      for (const row of result.rows) {
        const li = document.createElement('li');
        li.className = `chip chip--${row.info.severity} count-pill`;
        li.textContent = `${CATEGORY_ICON[row.info.category]} ${formatCp(row.cp)} ×${row.count}`;
        li.title = `${row.info.name}\n${row.info.note}`;
        countsEl.appendChild(li);
      }
    }

    // Security banner.
    $<HTMLDivElement>('risk-banner').hidden = result.topSeverity !== 'risk';

    // Cache the report for the copy-report button.
    lastReport = buildReport(result);
  }

  // debounced via rAF
  let raf = 0;
  const schedule = () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(run);
  };
  input.addEventListener('input', schedule);
  OPT_IDS.forEach((id) =>
    $(id).addEventListener('change', () => {
      saveOpts();
      run();
    }),
  );

  // samples
  document.querySelectorAll<HTMLButtonElement>('[data-sample]').forEach((b) =>
    b.addEventListener('click', () => {
      input.value = SAMPLES[b.dataset.sample!];
      run();
      setPane('output');
    }),
  );

  // --- mobile pane switcher
  function setPane(name: 'input' | 'output') {
    document.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) =>
      p.classList.toggle('max-md:hidden', p.dataset.pane !== name),
    );
    document.querySelectorAll<HTMLButtonElement>('[data-pane-tab]').forEach((t) => {
      const active = t.dataset.paneTab === name;
      t.setAttribute('aria-selected', String(active));
      t.classList.toggle('muted', !active);
      t.style.background = active ? 'var(--c-accent-soft)' : '';
      t.style.color = active ? 'var(--color-accent)' : '';
    });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-pane-tab]').forEach((t) =>
    t.addEventListener('click', () => setPane(t.dataset.paneTab as 'input' | 'output')),
  );

  // --- shared actions
  async function doPaste() {
    try {
      input.value = await navigator.clipboard.readText();
      run();
      setPane('output');
      toast('Pasted');
    } catch {
      input.focus();
      setPane('input');
      toast('Press Ctrl/Cmd+V to paste');
    }
  }
  async function doCopy() {
    if (!cleanedText) return;
    await navigator.clipboard.writeText(cleanedText);
    const b = $<HTMLButtonElement>('copy');
    const prev = b.textContent;
    b.textContent = '✓ Copied';
    toast('Cleaned text copied');
    setTimeout(() => (b.textContent = prev), 1300);
  }
  function doReset() {
    input.value = '';
    run();
    input.focus();
    setPane('input');
    toast('Cleared');
  }

  $('paste').addEventListener('click', doPaste);
  $('paste-bar').addEventListener('click', doPaste);
  $('copy').addEventListener('click', doCopy);
  $('copy-bar').addEventListener('click', doCopy);
  $('reset').addEventListener('click', doReset);
  $('clear-bar').addEventListener('click', doReset);

  // download cleaned text
  $<HTMLButtonElement>('download').addEventListener('click', () => {
    const blob = new Blob([cleanedText], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'cleaned.txt';
    a.click();
    URL.revokeObjectURL(url);
    toast('Downloaded cleaned.txt');
  });

  // copy plaintext report
  $<HTMLButtonElement>('report').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(lastReport);
      toast('Report copied');
    } catch {
      toast('Could not copy report');
    }
  });

  // view toggle (show invisibles vs cleaned)
  function setView(clean: boolean) {
    render.hidden = clean;
    output.hidden = !clean;
    $<HTMLButtonElement>('view-show').classList.toggle('muted', clean);
    $<HTMLButtonElement>('view-clean').classList.toggle('muted', !clean);
    $<HTMLButtonElement>('view-show').style.background = clean ? '' : 'var(--c-accent-soft)';
    $<HTMLButtonElement>('view-clean').style.background = clean ? 'var(--c-accent-soft)' : '';
  }
  $<HTMLButtonElement>('view-show').addEventListener('click', () => setView(false));
  $<HTMLButtonElement>('view-clean').addEventListener('click', () => setView(true));

  // keyboard: Cmd/Ctrl+Enter re-runs analysis (explicit flow for SR users)
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
      e.preventDefault();
      run();
      toast('Re-scanned');
    }
  });

  loadOpts();
  setView(false);
  setPane('input');
  run();
</script>
