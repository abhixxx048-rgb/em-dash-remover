---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Compute up to 3 related posts: rank other posts by shared keyword count,
// breaking ties (and filling any shortfall) by most recent pubDate.
const others = (await getCollection('blog')).filter((p) => p.id !== post.id);
const currentKeywords = new Set((post.data.keywords ?? []).map((k) => k.toLowerCase()));
const related = others
  .map((p) => ({
    post: p,
    shared: (p.data.keywords ?? []).filter((k) => currentKeywords.has(k.toLowerCase())).length,
  }))
  .sort(
    (a, b) =>
      b.shared - a.shared || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf()
  )
  .slice(0, 3)
  .map((r) => ({
    id: r.post.id,
    title: r.post.data.title,
    description: r.post.data.description,
    pubDate: r.post.data.pubDate,
  }));
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  related={related}
>
  <Content />
</BlogPost>
