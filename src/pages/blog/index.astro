---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base
  title="Blog — Writing, Punctuation & AI Text Guides"
  description="Guides on em dashes, punctuation, and editing AI-assisted writing. Learn the rules and clean up your text."
>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">The Blog</h1>
    <p class="mt-3 text-lg muted">
      Practical guides on punctuation, the em dash, and editing AI-assisted writing
      into your own clear, natural voice.
    </p>

    <div class="mt-10 space-y-4">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="card block p-5 transition hover:border-accent">
          <h2 class="text-lg font-bold">{post.data.title}</h2>
          <p class="mt-1.5 text-sm muted">{post.data.description}</p>
          <p class="mt-2 text-xs muted">{fmt(post.data.pubDate)}</p>
        </a>
      ))}
    </div>
  </main>
</Base>
