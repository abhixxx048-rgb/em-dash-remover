---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found (404) - Em Dash Remover" noindex={true}>
  <main class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-6xl font-extrabold text-accent">404</p>
    <h1 class="mt-4 text-2xl font-bold">Page not found</h1>
    <p class="mt-3 muted">The page you're looking for doesn't exist or has moved.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="inline-flex min-h-11 items-center rounded-lg bg-accent px-5 font-semibold text-white transition hover:opacity-90">Open the cleaner</a>
      <a href="/about" class="inline-flex min-h-11 items-center rounded-lg border border-ink/15 px-5 font-semibold transition hover:bg-ink/5">About</a>
    </div>
  </main>
</Base>
