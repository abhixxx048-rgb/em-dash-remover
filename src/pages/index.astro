---
import Base from '../layouts/Base.astro';
import Cleaner from '../components/Cleaner.astro';

const faqs = [
  {
    q: 'How do I remove em dashes from text?',
    a: 'Paste your text into the em dash remover box above, choose how em dashes should be replaced (Smart mode picks the grammatically correct fix automatically), then click Copy. The whole paste-clean-copy flow takes a few seconds and runs entirely in your browser.',
  },
  {
    q: 'How do I remove em dashes from ChatGPT text?',
    a: 'Copy the reply out of ChatGPT, paste it into the cleaner above, and the em dashes (along with smart quotes and invisible watermark characters that AI tools add) are removed in one pass. It works the same for text from Claude, Gemini or any other AI writing tool.',
  },
  {
    q: 'How do I remove em dashes in Word or Google Docs?',
    a: 'The fastest way is to paste your text into this tool, copy the cleaned result, and paste it back into your document. You can also use Find & Replace in Word or Google Docs and search for the em dash character (—), but that does a blind replace and will not fix the grammar around it. See our step-by-step guide for the exact Find & Replace codes.',
  },
  {
    q: 'How is this different from other em dash removers?',
    a: 'Most tools do a blind find-and-replace (every em dash becomes a comma), which creates comma splices and broken sentences. Our Smart mode looks at the surrounding words and picks the right fix - a comma, semicolon, colon, period, or parentheses - so the grammar stays correct.',
  },
  {
    q: 'How do I replace an em dash with a comma or hyphen?',
    a: 'Use the replacement selector above. Pick a comma, hyphen, en dash, period or space to force every em dash to one character, or leave it on Smart mode to let the tool choose the right replacement for each sentence automatically.',
  },
  {
    q: 'What is the difference between an em dash, en dash and hyphen?',
    a: 'A hyphen (-) joins words like "well-known". An en dash (–) is slightly longer and marks ranges like "10–20". An em dash (—) is the longest and sets off pauses or asides. AI tools overuse the em dash specifically, which is why it stands out.',
  },
  {
    q: 'Why does ChatGPT use so many em dashes?',
    a: 'Large language models learn punctuation from huge amounts of web and book text and gravitate to the em dash because it is a flexible, always-grammatical connector. The result is text peppered with dashes far more often than a human would use, which is why pasted AI text usually needs a cleanup.',
  },
  {
    q: 'Is this tool private, free and does it store my text?',
    a: 'It is completely free with no signup and no limits, and nothing is stored. All cleaning happens in your browser - open the DevTools Network tab while you use it and you will see zero requests. It even works offline.',
  },
  {
    q: 'What else does it clean besides em dashes?',
    a: 'En dashes, curly "smart" quotes, ellipsis characters, non-breaking spaces, invisible zero-width / watermark characters, extra whitespace, and (optionally) leftover markdown. It also scans for AI cliché phrases and overused vocabulary.',
  },
];

const webApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${Astro.site}#app`,
  name: 'AI Em Dash Remover & Text Cleaner',
  url: Astro.site,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web Browser',
  browserRequirements: 'Requires JavaScript.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  isAccessibleForFree: true,
  dateModified: '2026-06-15',
  featureList: [
    'Remove em dashes from text',
    'Grammar-aware em dash replacement',
    'Clean AI-generated text from ChatGPT, Claude and Gemini',
    'Remove invisible / zero-width / watermark characters',
    'Convert smart quotes to straight quotes',
  ],
  publisher: { '@id': `${Astro.site}#org` },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const howToSteps = [
  { name: 'Paste your text', text: 'Paste the AI or pasted text you want to fix into the cleaner box, or click an example to try it.' },
  { name: 'Choose how em dashes are replaced', text: 'Pick a replacement, or leave Smart mode on to let the tool choose a grammar-correct comma, colon, semicolon or parentheses for each sentence.' },
  { name: 'Clean and review', text: 'The em dashes are removed instantly along with smart quotes and invisible characters. Switch to Diff view to see exactly what changed.' },
  { name: 'Copy the clean text', text: 'Click Copy and paste the cleaned text back into Word, Google Docs, Notion or anywhere you need it.' },
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to remove em dashes from text',
  step: howToSteps.map((s) => ({ '@type': 'HowToStep', name: s.name, text: s.text })),
};
---

<Base
  title="Em Dash Remover – Free Online Tool, No Signup"
  description="Em dash remover that strips em dashes from ChatGPT and AI text with grammar-aware fixes. Free, no signup, runs 100% in your browser. Paste, clean, copy."
>
  <main class="halo">
    <!-- Hero: a galley proof being marked up in red pen -->
    <header class="mx-auto max-w-6xl px-4 pt-10 pb-8 sm:pt-14">
      <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
        <!-- Thesis -->
        <div class="lg:col-span-5">
          <p class="eyebrow" style="color: var(--color-accent);">The instrument <span class="muted">— clean AI text</span></p>
          <h1 class="mt-4 text-4xl sm:text-5xl lg:text-6xl">
            Strip the AI <span class="struck">tells</span>.<br />Keep your <span style="color: var(--color-accent);">human voice.</span>
          </h1>
          <p class="mt-4 max-w-xl text-base leading-relaxed muted">
            An em dash remover is a free online tool that strips em dashes (—) and
            other AI tells from your text, replacing them with grammar-correct
            punctuation in one click.
          </p>
          <p class="mt-3 max-w-xl text-lg leading-relaxed muted">
            Paste text from ChatGPT, Claude or Gemini and we clear em dashes, smart
            quotes and invisible characters with
            <strong style="color: var(--c-ink); font-weight: 600;">grammar-aware</strong>
            fixes — without sending a single byte anywhere.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-4">
            <a href="#paste" class="inline-flex min-h-12 items-center gap-2 rounded-lg px-6 font-semibold text-white shadow-sm transition hover:opacity-90" style="background: var(--color-accent);">
              Paste &amp; clean <span aria-hidden="true">→</span>
            </a>
            <span class="eyebrow muted">100% private · no signup</span>
          </div>
        </div>

        <!-- The signature: a marked-up galley proof -->
        <div class="lg:col-span-7">
          <figure class="galley card" aria-label="Example of an AI draft being copyedited into clean text">
            <figcaption class="galley-bar">
              <span class="eyebrow">draft.txt · marked up</span>
              <span class="galley-legend" aria-hidden="true"><i class="cut-key">cut</i><i class="add-key">kept</i></span>
            </figcaption>
            <div class="galley-body">
              <p class="galley-line"><span class="ln">1</span><span class="gl">We <span class="cut" style="--d:.6s" data-note="used">leveraged</span> a robust strategy</span></p>
              <p class="galley-line"><span class="ln">2</span><span class="gl">to unlock synergies <span class="cut" style="--d:1.2s" data-note=",">—</span> one that</span></p>
              <p class="galley-line"><span class="ln">3</span><span class="gl">is <span class="flag" data-note="cliché">truly game-changing</span>.</span></p>
              <p class="galley-line galley-out"><span class="ln" aria-hidden="true">✓</span><span class="gl">We used a strong strategy that connects teams.</span></p>
            </div>
          </figure>
        </div>
      </div>
    </header>

    <div id="paste">
      <Cleaner />
    </div>

    <!-- Value props -->
    <section class="mx-auto mt-20 max-w-5xl px-4">
      <p class="eyebrow text-mark">Why it reads differently</p>
      <div class="mt-6 grid overflow-hidden rounded-xl border sm:grid-cols-3" style="border-color: color-mix(in srgb, var(--c-ink) 12%, transparent); gap: 1px; background: color-mix(in srgb, var(--c-ink) 12%, transparent);">
        <div class="p-6" style="background: var(--c-surface);">
          <h2 class="text-xl">Grammar-correct, not just deleted</h2>
          <p class="mt-2 text-[0.95rem] muted">An em dash does many jobs. Smart mode reads the sentence around it and picks a comma, colon, semicolon or parentheses — so you never get a comma splice.</p>
        </div>
        <div class="p-6" style="background: var(--c-surface);">
          <h2 class="text-xl">Your words never leave the page</h2>
          <p class="mt-2 text-[0.95rem] muted">No upload, no server, no logging. Open the Network tab and watch — zero requests. Safe for confidential drafts, works offline.</p>
        </div>
        <div class="p-6" style="background: var(--c-surface);">
          <h2 class="text-xl">More than dashes</h2>
          <p class="mt-2 text-[0.95rem] muted">Invisible watermark characters, smart quotes, cliché phrases and overused words — all caught in one pass, with a live AI-tell score.</p>
        </div>
      </div>
    </section>

    <!-- Who it's for -->
    <section class="mx-auto mt-20 max-w-3xl px-4">
      <p class="eyebrow text-mark">Who it's for</p>
      <h2 class="mt-2 text-2xl font-bold">Who uses an em dash remover?</h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        <li class="card p-4 text-[0.95rem] muted"><strong style="color: var(--c-ink);">Students &amp; essay writers</strong> cleaning em dashes out of ChatGPT drafts so the writing reads in their own voice.</li>
        <li class="card p-4 text-[0.95rem] muted"><strong style="color: var(--c-ink);">Bloggers &amp; SEO writers</strong> who want to remove em dashes from AI text before it goes live.</li>
        <li class="card p-4 text-[0.95rem] muted"><strong style="color: var(--c-ink);">Developers &amp; technical writers</strong> stripping smart quotes and invisible characters that break code and snippets.</li>
        <li class="card p-4 text-[0.95rem] muted"><strong style="color: var(--c-ink);">Freelancers &amp; marketers</strong> polishing client copy, emails and LinkedIn posts so they don't read like AI.</li>
      </ul>
    </section>

    <hr class="rule-dash mx-auto mt-20 max-w-3xl" />

    <!-- SEO content -->
    <article class="seo mx-auto mt-12 max-w-3xl space-y-5 px-4 leading-relaxed">
      <p class="eyebrow text-mark">The em dash, explained</p>
      <h2 class="text-2xl font-bold">What is an em dash (—) and why remove it?</h2>
      <p class="muted">
        An em dash (-) is the longest dash in typography, wider than a hyphen (-)
        and an en dash (–). Writers use it to add a dramatic pause, insert an aside,
        or join related ideas. Used sparingly, it is excellent punctuation. The
        problem is that AI writing tools <em>overuse</em> it dramatically - studies of
        AI-generated text find em dashes appearing several times more often than in
        typical human writing. That makes the em dash one of the clearest signs that
        a piece was drafted by ChatGPT, Claude or Gemini.
      </p>

      <h2 class="text-2xl font-bold">Why does AI text contain so many em dashes?</h2>
      <p class="muted">
        Large language models learn punctuation patterns from huge amounts of web
        and book text, and they gravitate to the em dash because it is a flexible,
        always-grammatical connector. Combined with markdown formatting leaking into
        prose, the result is text peppered with dashes. Removing them - and the other
        tells like curly quotes and invisible characters - instantly makes writing
        read more naturally and personally.
      </p>

      <h2 class="text-2xl font-bold">How to remove em dashes from text</h2>
      <ol class="list-decimal space-y-2 pl-6 muted">
        {howToSteps.map((s) => (
          <li><strong>{s.name}.</strong> {s.text}</li>
        ))}
      </ol>
      <p class="muted">
        It works the same whether your text came from ChatGPT, an email draft, a
        LinkedIn post, or a school essay. Because everything runs in your browser,
        you can clean confidential text safely - nothing is uploaded.
      </p>

      <h3 class="text-lg font-semibold">Removing em dashes in Word or Google Docs</h3>
      <p class="muted">
        Microsoft Word and Google Docs both have Find &amp; Replace, but searching for
        "—" and replacing it with a comma is a blind swap that often breaks your
        sentences. For correct results, paste your text here first, let Smart mode fix
        the grammar, then copy it back into your document. Our step-by-step guide to
        <a href="/blog/how-to-remove-em-dashes-in-word-and-google-docs">removing em dashes in Word and Google Docs</a>
        covers the exact Find &amp; Replace character codes if you'd rather do it inside the app.
      </p>

      <h2 class="text-2xl font-bold">What else this tool cleans</h2>
      <p class="muted">
        Em dashes are only one AI tell. This cleaner also removes en dashes,
        converts curly "smart" quotes and apostrophes to straight ones, expands the
        ellipsis character (…) to three dots, strips non-breaking spaces and
        invisible zero-width "watermark" characters, and can remove leftover markdown.
        It also scores your text for clichéd phrases and overused AI vocabulary so you
        can see - and fix - what makes writing sound robotic.
      </p>
      <p class="muted">
        To go deeper, the
        <a href="/tools/invisible-watermark-character-inspector">invisible character inspector</a>
        reveals every hidden zero-width and watermark character that AI tools slip into
        text, and the
        <a href="/tools/before-after-diff-viewer">before/after diff viewer</a>
        lets you review each em dash fix and accept or reject it line by line.
      </p>

      <p class="mt-6 text-sm muted">Last updated: June 2026.</p>
    </article>

    <!-- More tools -->
    <section class="mx-auto mt-20 max-w-5xl px-4">
      <p class="eyebrow text-mark">The rest of the desk</p>
      <div class="mt-2 flex items-end justify-between">
        <h2 class="text-2xl font-bold">More free text tools</h2>
        <a href="/tools" class="text-sm font-medium text-accent hover:underline">See all 20 →</a>
      </div>
      <p class="mt-1 text-sm muted">Every tool runs 100% in your browser. No signup, no upload.</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { href: '/tools/invisible-watermark-character-inspector', icon: '👻', title: 'Invisible Character Inspector', desc: 'See & strip hidden zero-width and watermark characters.' },
          { href: '/tools/word-reading-time-counter', icon: '🔢', title: 'Word & Reading-Time Counter', desc: 'Live counts, reading time and platform limits.' },
          { href: '/tools/readability-grade-level-scorer', icon: '📊', title: 'Readability Scorer', desc: 'Flesch-Kincaid grade levels and hard sentences.' },
          { href: '/tools/human-voice-ai-tell-report', icon: '🫀', title: 'AI-Tell Report', desc: 'Find what makes your writing read like AI.' },
          { href: '/tools/emoji-decorative-symbol-stripper', icon: '🚫', title: 'Emoji Stripper', desc: 'Remove emoji and decorative bullets from text.' },
          { href: '/tools/case-converter', icon: '🔠', title: 'Case Converter', desc: 'UPPER, lower, Sentence and Title case.' },
        ].map((t) => (
          <a href={t.href} class="card group flex gap-3 p-4 transition hover:border-accent" style="text-decoration: none;">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl text-lg" style="background: var(--c-accent-soft);">{t.icon}</span>
            <span class="min-w-0">
              <span class="block font-semibold group-hover:text-accent">{t.title}</span>
              <span class="mt-0.5 block text-sm muted">{t.desc}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto mt-20 max-w-3xl px-4">
      <p class="eyebrow text-mark">Questions, answered</p>
      <h2 class="mt-2 text-2xl font-bold">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-ink/10">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none font-semibold marker:hidden">
              <span class="inline-flex w-full items-center justify-between">
                {f.q}
                <span class="ml-4 muted transition group-open:rotate-45">+</span>
              </span>
            </summary>
            <p class="mt-2 text-sm muted">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(webApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  </main>

  <!-- Clear the fixed mobile action bar so the footer is reachable. -->
  <style is:global>
    @media (max-width: 767px) { body { padding-bottom: 4.5rem; } }
    .seo a { color: var(--color-accent); text-decoration: underline; }

    /* ── Galley proof: the signature element ───────────────────── */
    .galley { padding: 0; overflow: hidden; }
    .galley-bar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0.55rem 0.9rem;
      border-bottom: 1px solid color-mix(in srgb, var(--c-ink) 11%, transparent);
      background: color-mix(in srgb, var(--c-ink) 3%, transparent);
    }
    .galley-legend { display: inline-flex; gap: 0.4rem; }
    .cut-key, .add-key {
      font-family: var(--font-mono); font-size: 0.6rem; font-weight: 500;
      text-transform: uppercase; letter-spacing: 0.12em;
      padding: 0.12rem 0.4rem; border-radius: 4px;
    }
    .cut-key { color: var(--color-mark); background: var(--c-mark-soft); }
    .add-key { color: var(--color-accent); background: var(--c-accent-soft); }

    .galley-body { padding: 1.2rem 1.2rem 1.4rem; font-family: var(--font-sans); font-size: 1.2rem; }
    .galley-line { display: flex; align-items: flex-start; gap: 0.85rem; line-height: 2.4; }
    .galley-line + .galley-line { margin-top: 0.1rem; }
    .ln {
      font-family: var(--font-mono); font-size: 0.7rem; color: var(--c-muted);
      width: 1.3rem; flex: none; text-align: right; padding-right: 0.6rem; padding-top: 0.55rem;
      border-right: 1px solid color-mix(in srgb, var(--c-ink) 10%, transparent);
    }
    .gl { padding-top: 0.1rem; }
    .galley-out {
      margin-top: 0.5rem; padding-top: 0.7rem;
      border-top: 1px dashed color-mix(in srgb, var(--c-ink) 14%, transparent);
    }
    .galley-out .ln { color: var(--color-ok); border-right-color: transparent; }
    .galley-out .gl { color: var(--c-muted); font-style: italic; }

    /* A word cut in red pen: animated strike + a margin note above. */
    .cut { position: relative; color: var(--color-mark); white-space: nowrap; }
    .cut::before {
      content: ''; position: absolute; left: -0.05em; right: -0.05em; top: 55%;
      height: 0.1em; background: var(--color-mark); border-radius: 2px;
      transform: scaleX(0); transform-origin: left;
      animation: gstrike 0.45s cubic-bezier(.6,0,.2,1) forwards; animation-delay: var(--d, 0.6s);
    }
    .cut::after {
      content: attr(data-note); position: absolute; right: 0; top: -1.15em;
      font-family: var(--font-mono); font-size: 0.62rem; color: var(--color-mark);
      opacity: 0; animation: gfade 0.4s ease forwards; animation-delay: calc(var(--d, 0.6s) + 0.3s);
    }
    /* A cliché flagged with a wavy underline + tag. */
    .flag {
      position: relative; text-decoration: underline wavy var(--color-mark);
      text-decoration-thickness: 1.5px; text-underline-offset: 3px;
    }
    .flag::after {
      content: attr(data-note); position: absolute; right: 0; top: -1.15em;
      font-family: var(--font-mono); font-size: 0.62rem; color: var(--color-mark);
      opacity: 0; animation: gfade 0.4s ease forwards; animation-delay: 1.8s;
    }
    @keyframes gstrike { to { transform: scaleX(1); } }
    @keyframes gfade { to { opacity: 1; } }

    @media (max-width: 767px) {
      .galley-body { font-size: 1.05rem; padding: 1rem; }
      .galley-line { line-height: 2.2; }
    }
    @media (prefers-reduced-motion: reduce) {
      .cut::before { transform: scaleX(1); animation: none; }
      .cut::after, .flag::after { opacity: 1; animation: none; }
    }
  </style>
</Base>
