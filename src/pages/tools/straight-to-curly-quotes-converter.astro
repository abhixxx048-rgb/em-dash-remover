---
import Base from '../../layouts/Base.astro';
import StraightToCurlyQuotesConverter from '../../components/tools/StraightToCurlyQuotesConverter.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import TrustStrip from '../../components/TrustStrip.astro';

const faqs = [
  {
    q: 'How do I convert straight quotes to curly quotes?',
    a: 'Paste your text into the box above, leave the default US/UK style on, and the tool instantly replaces every straight quote and apostrophe with the correctly-directional curly version. Then press Copy and paste the result wherever you publish. It also fixes dashes, ellipses and feet/inch primes in the same pass.',
  },
  {
    q: 'Why are my quotes straight and not curly?',
    a: 'Plain text, code editors, many web forms and pastes from ChatGPT use straight typewriter quotes (" and \') because that is the default keyboard glyph. Word and Google Docs auto-correct them to curly while you type, but text pasted in from elsewhere keeps its straight quotes - which is exactly what this converter fixes.',
  },
  {
    q: 'How do I change straight quotes to smart quotes in Word or Google Docs?',
    a: 'In Word, turn on File → Options → Proofing → AutoCorrect → "Straight quotes with smart quotes"; in Google Docs it is Tools → Preferences → "Use smart quotes". Both only curl quotes you type fresh, so for pasted or imported text - or quotes Word curls the wrong way (’90s) - paste it here to fix every mark at once.',
  },
  {
    q: 'How do I type a curly apostrophe?',
    a: 'On its own a curly apostrophe is ’ (U+2019) - on a Mac press Option + Shift + ], on Windows hold Alt and type 0146. That is fiddly for a whole document, so paste your text into this converter and every straight apostrophe becomes a proper curly one automatically, facing the right way even in don’t, ’em and Hastings’.',
  },
  {
    q: 'Why did Word curl my ’90s the wrong way?',
    a: 'Word (and most auto-correct) sees an apostrophe at the start of "90s" and assumes it is an opening single quote, so it curls it as ‘90s. But the apostrophe stands in for the missing "19", so it should face the other way - a closing apostrophe, ’90s. This converter detects the apostrophe-then-digits pattern and curls it correctly as ’90s by default.',
  },
  {
    q: 'Which quote is opening and which is closing?',
    a: 'The opening quotes are “ (double) and ‘ (single); the closing quotes are ” and ’. As a rule, a quote that follows a space, a bracket, or the start of a line opens; a quote that follows a letter closes. An apostrophe inside or at the end of a word (don’t, Hastings’) is always the closing form ’.',
  },
  {
    q: 'How do I make foot and inch marks (primes) instead of quotes?',
    a: 'Keep the "Feet/inch primes" option on. The tool detects measurement patterns like 6\'2", 5\' 10" and 5" and emits true prime ′ and double-prime ″ symbols instead of curly quotes, so 6\'2" becomes 6′2″ rather than 6’2”. Turn the option off if you would rather those marks stay plain.',
  },
  {
    q: 'What is the difference between curly and straight quotes?',
    a: 'Straight quotes (" and \') are typewriter marks - the same glyph is used to open and close. Curly, or "smart", quotes are directional (“ ” and ‘ ’) and are what professional typesetting uses. Straight quotes in published copy are the number-one "looks amateur" tell.',
  },
  {
    q: 'What is the HTML entity for curly quotes?',
    a: 'The curly double quotes are &#8220; (“) and &#8221; (”); the singles are &#8216; (‘) and &#8217; (’), with ’ doubling as the apostrophe. Switch on "Output HTML entities" and the converter emits those numeric entities instead of literal Unicode, which is handy for templates or a CMS that mangles raw smart quotes.',
  },
  {
    q: 'Do I need curly quotes for an ebook?',
    a: 'Yes - reputable ebook stores and print typesetters expect smart quotes, and straight quotes are the number-one "looks self-published" tell on a page. Run your manuscript through this converter before export to get directional quotes, true apostrophes, en/em dashes and an ellipsis in one pass, all without uploading the file anywhere.',
  },
  {
    q: 'Are smart quotes safe to use in code or URLs?',
    a: 'No - code and URLs need straight quotes, and curly ones will break them. This converter leaves anything inside backticks, fenced code blocks, and URLs or file paths untouched, so the straight quotes that must stay straight are preserved automatically.',
  },
  {
    q: 'Does this upload my text?',
    a: 'No. All conversion runs in your browser with plain JavaScript. Nothing is uploaded, stored, or logged - open your DevTools Network tab while you use it and you will see zero requests. It also works offline, which makes it safe for confidential manuscripts.',
  },
  {
    q: 'How do I convert curly quotes back to straight?',
    a: 'Use the reverse tool - the site\'s curly→straight cleaner turns smart quotes, em dashes and ellipses back into plain typewriter punctuation. The two tools are a matched pair: smarten or dumb-down your quotes either direction.',
  },
  {
    q: 'What does SmartyPants do?',
    a: 'SmartyPants is the classic algorithm (by John Gruber) that "educates" straight quotes, dashes and ellipses into typographic ones. This converter is a hand-rolled adaptation of it, extended to fix the cases SmartyPants is known to miss: decades (’90s), leading contractions (’Twas, ’em) and feet/inch primes.',
  },
];

const webApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${Astro.site}tools/straight-to-curly-quotes-converter#app`,
  name: 'Smart Quotes Converter - Straight to Curly Quotes',
  url: `${Astro.site}tools/straight-to-curly-quotes-converter`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web Browser',
  browserRequirements: 'Requires JavaScript.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  isAccessibleForFree: true,
  dateModified: '2026-06-15',
  featureList: [
    'Convert straight quotes to curly (smart) quotes',
    'Directional opening and closing quotes done right',
    'Fix decade apostrophes (’90s) and leading contractions (’Twas, ’em)',
    'Feet and inch prime symbols (6′2″) instead of curly quotes',
    'Convert -- and --- to en and em dashes, ... to an ellipsis',
    'Leave code, backticks and URLs untouched',
    'US, UK, German and French quote styles',
  ],
  publisher: { '@id': `${Astro.site}#org` },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to convert straight quotes to curly quotes',
  step: [
    {
      '@type': 'HowToStep',
      name: 'Paste your text',
      text: 'Paste or type text with straight quotes into the converter box (or tap an example).',
    },
    {
      '@type': 'HowToStep',
      name: 'Configure the options',
      text: 'Pick your quote style - US/UK English, German „ “ or French « » - and toggle primes, dashes and the ellipsis to taste.',
    },
    {
      '@type': 'HowToStep',
      name: 'Convert and verify',
      text: 'The curly result updates live; switch to Diff to verify exactly which marks changed.',
    },
    {
      '@type': 'HowToStep',
      name: 'Copy the result',
      text: 'Copy the typeset text (or press Ctrl/Cmd + Enter) and paste it wherever you publish.',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Straight to Curly Quotes Converter - Free Smart Quotes Tool"
  description="Free straight to curly quotes converter: turn straight quotes into correctly-directional curly quotes, true apostrophes, en/em dashes and primes. No signup, 100% in-browser."
>
  <main class="halo">
    <!-- Editorial header -->
    <header class="mx-auto max-w-3xl px-4 pt-10 pb-2">
      <a href="/tools" class="eyebrow text-accent hover:underline">← All tools</a>
      <p class="eyebrow text-mark mt-6">Copydesk · smart quotes</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">
        Straight quotes in. Curly quotes out.
      </h1>
      <p class="mt-4 max-w-2xl leading-relaxed muted">
        A <strong style="color: var(--c-ink); font-weight: 600;">straight to curly quotes converter</strong> is a free smart quotes tool that replaces typewriter quotes (<code class="font-mono">"</code> and <code class="font-mono">'</code>) with the correctly-directional curly, or "smart", quotes (“ ” ‘ ’) that professional typesetting uses.
      </p>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed muted">
        Turn typewriter quotes, apostrophes, <code class="font-mono">--</code> and <code class="font-mono">...</code> into correctly-directional curly quotes, true apostrophes, proper en/em dashes and a real ellipsis — with the tricky cases (<strong style="color: var(--c-ink); font-weight: 600;">’90s</strong>, <strong style="color: var(--c-ink); font-weight: 600;">’Twas</strong>, <strong style="color: var(--c-ink); font-weight: 600;">6′2″</strong>) actually handled right. Done in your browser, instantly.
      </p>
    </header>

    <hr class="rule-dash mx-auto my-8 max-w-3xl" />

    <StraightToCurlyQuotesConverter />

    <TrustStrip />

    <!-- Who it's for -->
    <section class="mx-auto mt-20 max-w-3xl px-4">
      <h2 class="text-2xl font-bold">Who the curly quotes converter is for</h2>
      <ul class="mt-4 flex flex-wrap gap-2 text-sm muted">
        <li class="rounded-full border border-ink/10 px-3 py-1">Authors &amp; ebook publishers needing smart quotes for publishing</li>
        <li class="rounded-full border border-ink/10 px-3 py-1">Writers &amp; editors fixing straight quotes in pasted text</li>
        <li class="rounded-full border border-ink/10 px-3 py-1">Bloggers converting quotes for ChatGPT or Word copy</li>
        <li class="rounded-full border border-ink/10 px-3 py-1">SEO &amp; content teams polishing typography for the web</li>
        <li class="rounded-full border border-ink/10 px-3 py-1">Designers &amp; typesetters wanting true apostrophes and primes</li>
      </ul>
    </section>

    <!-- SEO content -->
    <article class="seo mx-auto mt-16 max-w-3xl space-y-5 px-4 leading-relaxed">
      <h2 class="text-2xl font-bold">How to convert straight quotes to curly quotes</h2>
      <ol class="list-decimal space-y-2 pl-6 muted">
        <li><strong>Paste</strong> or type text with straight quotes into the box above (or tap an example).</li>
        <li><strong>Configure</strong> your quote style - US/UK English, German „ “ or French « » - and toggle primes, dashes and the ellipsis to taste.</li>
        <li><strong>Convert</strong> instantly as the curly result updates live; switch to <strong>Diff</strong> to verify exactly which marks changed.</li>
        <li><strong>Copy</strong> the result (or press Ctrl/Cmd + Enter) and paste the typeset text wherever you publish.</li>
      </ol>

      <h2 class="text-2xl font-bold">Straight vs curly quotes - which way does each mark face?</h2>
      <p class="muted">
        Straight quotes (<code>"</code> and <code>'</code>) are typewriter
        leftovers: the same glyph opens and closes. Professional typesetting uses
        directional <em>curly</em> quotes instead. The opening marks are
        <strong>“</strong> and <strong>‘</strong>; the closing marks are
        <strong>”</strong> and <strong>’</strong>. The rule of thumb: a quote that
        follows a space, a bracket, or the start of a line <em>opens</em>, and a
        quote that follows a letter <em>closes</em>. An apostrophe inside or at the
        end of a word - <em>don’t</em>, <em>Hastings’</em> - is always the closing
        form ’. For a deeper look at when each style belongs in your copy, read
        <a href="/blog/curly-quotes-vs-straight-quotes">curly quotes vs straight quotes</a>.
      </p>

      <h2 class="text-2xl font-bold">The tricky cases we get right: ’90s, ’Twas, and foot/inch marks (6'2")</h2>
      <p class="muted">
        This is where Word, Google Docs and most thin converter clones fail. When
        an apostrophe leads a decade - <strong>’90s</strong>, <strong>’08</strong> -
        it stands in for the dropped "19", so it must curl as a <em>closing</em>
        apostrophe ’, not an opening ‘. Auto-correct almost always gets this
        backwards. The same is true for leading contractions like
        <strong>’Twas</strong>, <strong>’em</strong>, <strong>’cause</strong> and
        <strong>’round</strong>. And foot/inch measurements such as
        <strong>6'2"</strong> or <strong>5' 10"</strong> should become true prime
        symbols (<strong>6′2″</strong>), not curly quotes. This converter detects
        all three patterns by default and lights up a chip so you can see it caught
        them.
      </p>

      <h2 class="text-2xl font-bold">En dash vs em dash vs hyphen, and -- / --- shortcuts</h2>
      <p class="muted">
        Three different marks do three different jobs: the hyphen (-) joins words
        (well-known), the en dash (–) spans ranges (10–20, May–September), and the
        em dash (-) marks a strong break in a sentence. The classic typewriter
        shortcut is <code>--</code> for an en dash and <code>---</code> for an em
        dash, and this tool expands both automatically. It also turns three dots
        (<code>...</code>) into a single ellipsis character (…) so your line breaks
        and spacing behave the way a typesetter expects.
      </p>

      <h2 class="text-2xl font-bold">For developers - Unicode vs HTML entities, code and URLs</h2>
      <p class="muted">
        Curly quotes are great in prose and terrible in code. This converter runs a
        preserve guard that skips anything inside backticks, fenced code blocks, and
        URLs or file paths, so the straight quotes that must stay straight are left
        alone. If your CMS stores SmartyPants-style entities, switch on
        <strong>Output HTML entities</strong> to emit <code>&amp;#8220;</code> /
        <code>&amp;#8217;</code> instead of literal Unicode. Everything is plain,
        deterministic JavaScript - no SmartyPants build step required. If your text
        arrived as a mangled paste, run it through the
        <a href="/tools/paste-from-word-docs-cleaner">paste-from-Word docs cleaner</a>
        first, then smarten the quotes here; to fix headings and titles afterward,
        the <a href="/tools/case-converter">case converter</a> handles AP and Chicago
        title case.
      </p>

      <h2 class="text-2xl font-bold">Privacy - everything runs in your browser</h2>
      <p class="muted">
        There is no server and no upload. All conversion happens on your device, so
        you can safely typeset confidential or unpublished manuscripts. Open your
        browser's DevTools Network tab while you work and you'll see zero requests -
        and the tool keeps working with your connection turned off.
      </p>
    </article>

    <!-- FAQ -->
    <section class="mx-auto mt-16 max-w-3xl px-4">
      <h2 class="text-2xl font-bold">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-ink/10">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none font-semibold marker:hidden">
              <span class="inline-flex w-full items-center justify-between">
                {f.q}
                <span class="ml-4 muted transition group-open:rotate-45">+</span>
              </span>
            </summary>
            <p class="mt-2 text-sm muted">{f.a}</p>
          </details>
        ))}
      </div>
      <p class="mt-8 text-sm muted">Last updated: June 2026</p>
    </section>

    <RelatedTools currentSlug="straight-to-curly-quotes-converter" />

    <script type="application/ld+json" set:html={JSON.stringify(webApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </main>

  <!-- Clear the fixed mobile action bar so the footer is reachable. -->
  <style is:global>
    @media (max-width: 767px) { body { padding-bottom: 4.5rem; } }
    .seo a { color: var(--color-accent); text-decoration: underline; }
    .seo code { font-family: var(--font-mono); font-size: 0.9em; }
  </style>
</Base>
