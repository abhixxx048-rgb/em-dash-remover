---
import Base from '../../layouts/Base.astro';
import WordReadingTimeCounter from '../../components/tools/WordReadingTimeCounter.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import TrustStrip from '../../components/TrustStrip.astro';

const faqs = [
  {
    q: 'Is there a free word counter with no signup?',
    a: 'Yes. This is a free online word counter with no signup, no login and no ads. Paste your text and the word count, character count and reading time appear instantly. There is no usage cap and nothing to install.',
  },
  {
    q: 'How do you calculate reading time?',
    a: 'Reading time is your word count divided by a words-per-minute rate. The default, 238 wpm, is the average silent-reading speed from a large 2019 meta-analysis by Brysbaert. You can switch to Slow (150) or Fast (350) so the estimate matches how you actually read.',
  },
  {
    q: 'What is the average reading speed in words per minute?',
    a: 'The average adult reads silently at about 238 words per minute, based on Brysbaert’s 2019 meta-analysis. Reading aloud is slower, around 180 wpm. This counter defaults to 238 wpm and lets you pick Slow (150) or Fast (350) to estimate read time for any blog post or article.',
  },
  {
    q: 'How long does it take to read 1000 words?',
    a: 'At the average reading speed of 238 wpm, 1,000 words takes roughly 4 minutes to read silently. A 500-word essay is about 2 minutes and 2,000 words is around 8–9 minutes. Paste your text and the reading-time estimate updates live as the word count changes.',
  },
  {
    q: 'How many words is a 5 minute speech?',
    a: 'At a comfortable speaking pace of 130 wpm, a 5-minute speech is about 650 words; a 3-minute speech is roughly 390 words and a 10-minute talk is around 1,300 words. Paste your script and the speaking-time readout tells you exactly how long it runs.',
  },
  {
    q: 'How many words per minute do people speak?',
    a: 'Speaking time here uses 130 wpm, a comfortable presentation pace. Conversational speech runs faster (150–160 wpm), but 130 leaves room for pauses and emphasis, which is what most speakers actually need when timing a talk or presentation.',
  },
  {
    q: 'How do I count characters with and without spaces?',
    a: 'The counter shows characters with spaces and characters without spaces side by side, plus the X (280), Instagram, LinkedIn, Threads and SMS limits. It is a handy character counter for Twitter, Instagram captions and LinkedIn posts without opening each platform.',
  },
  {
    q: 'Does my text get uploaded anywhere?',
    a: 'No. Every count, limit and estimate is computed in your browser with JavaScript. Nothing is sent to a server, stored remotely, or logged. Open DevTools → Network while you type and you will see zero requests. It even works offline.',
  },
  {
    q: 'Why does my count differ from Microsoft Word?',
    a: 'Word and every counter make slightly different choices about hyphenated words, numbers, and symbols. We count Unicode-aware word-like runs (so contractions and hyphenated words count as one, and CJK or emoji text counts correctly), which can differ by a few words from Word’s rules.',
  },
];

const webApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${Astro.site}tools/word-reading-time-counter#app`,
  name: 'Word & Reading-Time Counter',
  url: `${Astro.site}tools/word-reading-time-counter`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web Browser',
  browserRequirements: 'Requires JavaScript.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  isAccessibleForFree: true,
  dateModified: '2026-06-15',
  featureList: [
    'Live word and character counter',
    'Reading time and speaking time calculator',
    'Twitter / X, LinkedIn, Instagram, Threads and SMS character limits',
    'SEO title and meta description length checker',
    'Keyword density and readability grade',
    '100% client-side - text never leaves your browser',
  ],
  publisher: { '@id': `${Astro.site}#org` },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to use the word counter and reading-time calculator',
  step: [
    {
      '@type': 'HowToStep',
      name: 'Paste your text',
      text: 'Open the tool and paste or type your text into the box — an essay, blog post, tweet, caption or speech script. Counting starts instantly; there is no signup and nothing is uploaded.',
    },
    {
      '@type': 'HowToStep',
      name: 'Read the live counts',
      text: 'Watch the live word count, character count, sentence and paragraph totals, plus reading time and speaking time update as you type.',
    },
    {
      '@type': 'HowToStep',
      name: 'Pick your reading or speaking pace',
      text: 'Switch the words-per-minute rate to Slow, Average or Fast to estimate how long it takes to read, or use the 130 wpm speaking pace to time a speech.',
    },
    {
      '@type': 'HowToStep',
      name: 'Check the platform limits',
      text: 'Glance at the X, LinkedIn, Instagram, Threads, SMS and SEO limit pills to confirm your text fits where you plan to publish it, then edit until it does.',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Word Counter + Character Counter & Reading-Time Calculator"
  description="Free online word counter and character counter with live reading time, speaking time and X, LinkedIn, Instagram & SMS limits. No signup, in-browser, nothing uploaded."
>
  <main class="halo">
    <!-- Editorial header -->
    <header class="mx-auto max-w-3xl px-4 pt-10 pb-2">
      <a href="/tools" class="eyebrow text-accent hover:underline">← All tools</a>
      <p class="eyebrow text-mark mt-6">Copydesk · word &amp; time count</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">
        Word counter &amp; reading-time calculator
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed muted">
        A <strong style="color: var(--c-ink); font-weight: 600;">word counter</strong> is a tool that tallies the words, characters, sentences and paragraphs in your text and estimates how long it takes to read or speak — live, as you type, with no signup.
      </p>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed muted">
        Paste any text to see live <strong style="color: var(--c-ink); font-weight: 600;">word</strong>, <strong style="color: var(--c-ink); font-weight: 600;">character</strong>, sentence and paragraph counts, plus <strong style="color: var(--c-ink); font-weight: 600;">reading and speaking time</strong> and platform-limit pills for X, LinkedIn, Instagram, Threads, SMS and SEO. Nothing is uploaded — your text never leaves your browser.
      </p>
    </header>

    <hr class="rule-dash mx-auto my-8 max-w-3xl" />

    <WordReadingTimeCounter />

    <TrustStrip />

    <!-- Who it's for -->
    <section class="mx-auto mt-20 max-w-3xl px-4">
      <h2 class="text-2xl font-bold">Who it's for</h2>
      <p class="mt-3 muted">A fast, private word and character counter for anyone working to a length, a limit or a deadline:</p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        <li class="card p-4 text-sm">
          <strong>Students &amp; essay writers</strong> — hit a 500, 1,000 or 2,000-word target and see how long the essay takes to read.
        </li>
        <li class="card p-4 text-sm">
          <strong>Speakers &amp; presenters</strong> — convert words to minutes and time a 3, 5 or 10-minute speech before you stand up.
        </li>
        <li class="card p-4 text-sm">
          <strong>Bloggers &amp; SEO writers</strong> — add an accurate reading-time estimate to a blog post and keep titles and meta descriptions in range.
        </li>
        <li class="card p-4 text-sm">
          <strong>Social media &amp; marketers</strong> — check the character count for a tweet, Instagram caption or LinkedIn post against each platform limit.
        </li>
        <li class="card p-4 text-sm">
          <strong>Freelancers &amp; editors</strong> — count words without Microsoft Word and keep confidential client drafts in the browser.
        </li>
      </ul>
    </section>

    <!-- How to use -->
    <section class="mx-auto mt-16 max-w-3xl px-4">
      <h2 class="text-2xl font-bold">How to use the word counter</h2>
      <ol class="mt-4 space-y-3 muted list-decimal pl-6">
        <li><strong>Paste or type your text</strong> into the box above — essay, blog post, tweet, caption or speech script. Counting starts instantly; no signup, nothing uploaded.</li>
        <li><strong>Read the live counts</strong> — word count, character count (with and without spaces), sentences, paragraphs, plus reading time and speaking time, all updating as you type.</li>
        <li><strong>Pick your pace</strong> — switch the words-per-minute rate to Slow, Average or Fast for reading time, or use the 130 wpm speaking pace to time a talk.</li>
        <li><strong>Check the platform limits</strong> — glance at the X, LinkedIn, Instagram, Threads, SMS and SEO pills to confirm your text fits where you plan to publish.</li>
        <li><strong>Edit and re-check</strong> — trim or expand until the count, reading time and limits all land where you want them.</li>
      </ol>
    </section>

    <!-- SEO content -->
    <article class="seo mx-auto mt-20 max-w-3xl space-y-5 px-4 leading-relaxed">
      <h2 class="text-2xl font-bold">Live counts: words, characters, sentences, paragraphs</h2>
      <p class="muted">
        As you type or paste, the counter updates instantly - no “count” button. It
        uses Unicode-aware counting (via the browser’s <code>Intl.Segmenter</code>),
        so hyphenated words and contractions count as one word, accented letters and
        emoji count as a single character, and non-Latin scripts are handled
        correctly. You also get characters without spaces, sentence and paragraph
        counts, raw line counts, and average word length - everything a student,
        editor or freelancer needs to hit a target or stay under a cap.
      </p>

      <h2 class="text-2xl font-bold">Reading &amp; speaking time, and how we calculate it</h2>
      <p class="muted">
        Reading time is your word count divided by a words-per-minute rate. The
        default of <strong>238 wpm</strong> is the average silent-reading speed from
        Brysbaert’s 2019 meta-analysis; switch to Slow (150) or Fast (350) to match
        how you actually read. Speaking time uses <strong>130 wpm</strong>, a
        realistic presentation pace with room for pauses - handy when you need to fit
        a script into a five-minute slot. For the full breakdown of common lengths -
        how long it takes to read 500, 1,000 or 2,000 words - see our guide on
        <a href="/blog/how-long-does-it-take-to-read-x-words">how long it takes to read X words</a>.
        Once the length looks right, run the draft through our
        <a href="/tools/readability-grade-level-scorer">readability grade-level scorer</a>
        to check it is easy to read, or the
        <a href="/tools/sentence-splitter">sentence splitter</a> to audit cadence one line at a time.
      </p>

      <h2 class="text-2xl font-bold">Platform limits: X, LinkedIn, Instagram, Threads, SMS &amp; SEO</h2>
      <p class="muted">
        The limit pills tell you at a glance whether your text fits where you want to
        post it. Each pill shows used / limit and turns amber as you approach the cap
        and red when you go over, paired with an icon and an “over by N” label so the
        status never relies on color alone. We cover X (280), Threads (500), LinkedIn
        (3,000), Instagram captions (2,200), SMS segments, an SEO title (~60
        characters) and a meta description (~155). The SMS panel even flags which
        emoji or curly quotes forced your message into the shorter Unicode encoding.
      </p>

      <h2 class="text-2xl font-bold">100% client-side - your text never leaves your browser</h2>
      <p class="muted">
        This is the difference. Most word counters run ads and quietly send your
        keystrokes to a server; ours computes everything locally in JavaScript. There
        is no upload, no account, and no logging - open your browser’s DevTools,
        switch to the Network tab, and you will see zero requests as you type. That
        makes it safe for confidential drafts, client work and anything you would not
        paste into a random website. It is the same provable-privacy promise behind
        our em-dash and AI-text cleaning tools: clean writing for real quality, with
        your human voice kept intact.
      </p>
    </article>

    <!-- FAQ -->
    <section class="mx-auto mt-16 max-w-3xl px-4">
      <h2 class="text-2xl font-bold">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-ink/10">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none font-semibold marker:hidden">
              <span class="inline-flex w-full items-center justify-between">
                {f.q}
                <span class="ml-4 muted transition group-open:rotate-45">+</span>
              </span>
            </summary>
            <p class="mt-2 text-sm muted">{f.a}</p>
          </details>
        ))}
      </div>
      <p class="mt-8 text-xs muted">Last updated: June 2026</p>
    </section>

    <RelatedTools currentSlug="word-reading-time-counter" />

    <script type="application/ld+json" set:html={JSON.stringify(webApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </main>

  <style is:global>
    .seo a { color: var(--color-accent); text-decoration: underline; }
    .seo code { font-family: var(--font-mono); font-size: 0.9em; }
  </style>
</Base>
