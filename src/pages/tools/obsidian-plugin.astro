---
import Base from '../../layouts/Base.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import TrustStrip from '../../components/TrustStrip.astro';

const features = [
  {
    title: 'Silent, instant clean-on-paste',
    body: 'The cleanup happens on the paste event itself - you paste from ChatGPT or Claude and the text is already clean, with no button, modal, or extra keystroke. Frictionless invisibility is the whole point.',
  },
  {
    title: 'Post-paste "cleaned N items" toast',
    body: 'A brief, dismissible notice like “Cleaned: 3 em dashes, 2 curly quotes, 1 invisible char” after each paste makes the invisible work visible and trustworthy - without interrupting your flow.',
  },
  {
    title: 'Status-bar live counter',
    body: 'A status-bar chip shows a running session tally (“AI tells cleaned: 142”). Lightweight feedback that quietly reinforces the habit every time you glance down.',
  },
  {
    title: 'One-click “Undo this clean”',
    body: 'The toast includes an inline Undo that reverts just the cleaning and re-inserts the original payload. Reversibility is what makes silent automation feel safe.',
  },
  {
    title: 'Aggressiveness presets',
    body: 'One-tap profiles: Conservative (dashes + invisible chars only), Standard (full default set), and Strict (also flatten exotic spaces and normalize repeated punctuation).',
  },
  {
    title: 'Per-rule toggles with live examples',
    body: 'Each toggle shows a tiny before → after (“text-here → text - here”), so you understand exactly what every rule does instead of guessing from a jargon label.',
  },
  {
    title: '“Why this is a tell” education tooltips',
    body: 'Info icons explain why em dashes, curly quotes and zero-width chars read as AI - keeping the focus on your human voice and quality, never on detector-bypass.',
  },
  {
    title: 'AI-tell scan command',
    body: 'A “Scan note for AI tells” command highlights remaining tells (em-dash density, hedging phrases, invisible chars) in a side panel with counts - turning the plugin from a silent fixer into an active coach.',
  },
  {
    title: 'Hotkey-first design',
    body: 'Every action - clean selection, clean note, scan, toggle clean-on-paste - is a discrete command, so power users bind them to chords and never touch the mouse.',
  },
  {
    title: 'Right-click context menu',
    body: 'A “Clean selection with Em Dash Remover” entry on the editor right-click menu meets you where your hand already is and aids discovery if you don’t memorize commands.',
  },
  {
    title: 'Quick-toggle ribbon icon',
    body: 'A left-ribbon button flips clean-on-paste on and off, with the icon state showing whether it’s armed - one-glance control for the moments you do want a verbatim paste.',
  },
  {
    title: 'Per-folder rules',
    body: 'Let a “drafts/” folder use Strict while a “code/” folder is off, via a simple path-glob list - because the same person wants different behavior for prose vs. snippets.',
  },
  {
    title: 'Dry-run preview-before-replace',
    body: 'An optional diff modal shows additions and removals before inserting, with an “Insert clean” / “Keep original” choice - converting cautious academics and legal note-takers into permanent users.',
  },
  {
    title: 'Theme-native, dark/light & mobile parity',
    body: 'Built on Obsidian’s own CSS variables so the UI matches your theme, with the paste handler verified on iOS and Android where people increasingly paste AI output.',
  },
];

const howItWorks = [
  {
    step: '1',
    title: 'Paste from any AI chat',
    body: 'Copy a draft out of ChatGPT, Claude or Gemini and paste it into a note. The plugin catches Obsidian’s editor-paste event before a single character lands.',
  },
  {
    step: '2',
    title: 'The cleaning engine runs locally',
    body: 'Code blocks are masked, then the same grammar-aware rules as the website run: em/en-dash replacement, curly → straight quotes, ellipsis normalization, zero-width / watermark stripping and whitespace cleanup.',
  },
  {
    step: '3',
    title: 'Clean Markdown is inserted',
    body: 'Only if something actually changed does the plugin replace the paste - so it never fights Obsidian’s native paste, and a toast shows exactly what was cleaned with a one-click undo.',
  },
];

const faqs = [
  {
    q: 'Will it send my notes anywhere?',
    a: 'No. Obsidian runs locally, and the plugin is being built to declare no host permissions, ship no analytics and make zero network calls. It is designed to read only the clipboard payload of the current paste - the same local-only approach as the web tool, so nothing leaves your vault.',
  },
  {
    q: 'Will it break my code blocks?',
    a: 'No. Before any character-level rule runs, fenced (```) and inline (`code`) spans are masked out and restored afterward, so dashes, straight quotes and other normalizations can never corrupt a snippet, JSON or a shell command.',
  },
  {
    q: 'Can I keep the original sometimes?',
    a: 'Yes. A bypass-paste command (suggested Ctrl/Cmd+Shift+V) inserts the original verbatim, and per-folder rules let you turn cleaning off entirely for folders like “code/”. The ribbon toggle also disarms clean-on-paste with one click.',
  },
  {
    q: 'Does it work on mobile?',
    a: 'Yes. Obsidian uses CodeMirror 6 on both desktop and mobile, so the editor-paste handler fires on iOS and Android too. Toasts are kept short and tap targets large, and the clean action is reachable from the long-press editor menu.',
  },
  {
    q: 'How is this different from Smart Typography?',
    a: 'Smart Typography does the opposite - it adds curly quotes and em dashes as you type. This plugin goes the other direction, un-fancying AI output back to plain punctuation, and it runs on paste rather than on every keystroke.',
  },
  {
    q: 'Does it remove AI watermarks?',
    a: 'It strips the zero-width and invisible characters AI text often carries - ZWSP, ZWNJ, ZWJ, word joiner, BOM, soft hyphen and the Unicode tag block - which is where invisible “watermark” characters live.',
  },
  {
    q: 'How is this different from Clean AI Paste or Paste Reformatter?',
    a: 'Those focus on Markdown structure, emoji or DIY regex you author yourself. This plugin adds grammar-aware em-dash replacement, built-in invisible-character stripping and an AI-tell scan, with a trusted web companion that shares the exact same cleaning engine - so there’s no rule drift.',
  },
  {
    q: 'How do I remove em dashes in Obsidian?',
    a: 'Once enabled, the plugin removes em dashes from notes automatically every time you paste AI text - swapping each em dash for a grammar-appropriate comma, semicolon, colon or spaced hyphen. To fix text already in a note, select it and run the “Clean selection” command or use the right-click menu.',
  },
  {
    q: 'Can it strip emojis and remove extra blank lines on paste?',
    a: 'Yes. Alongside em dashes and curly quotes, the cleaning engine strips decorative emojis and collapses the extra blank lines and stray whitespace that ChatGPT and Claude output add, so pasted notes arrive as tidy Markdown instead of double-spaced, emoji-littered text.',
  },
  {
    q: 'Does the plugin work offline, and is it free?',
    a: 'Yes to both. It is a free, open-source community plugin that runs entirely on your device with zero network calls, so it works fully offline. There is no signup, no account and no paid tier - the same approach as the free web tool.',
  },
  {
    q: 'How do I install the plugin in Obsidian?',
    a: 'Open Settings → Community plugins → Browse, search for “Em Dash Remover”, click Install, then Enable. Before it clears community-plugin review you can install the beta manually or through BRAT by pointing it at the GitHub repo.',
  },
];

const pageUrl = `${Astro.site}tools/obsidian-plugin`;

const softwareApp = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${pageUrl}#app`,
  name: 'Em Dash Remover for Obsidian',
  url: pageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Obsidian (Windows, macOS, Linux, iOS, Android)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  isAccessibleForFree: true,
  dateModified: '2026-06-15',
  featureList: [
    'Clean-on-paste interception for ChatGPT, Claude and Gemini text',
    'Grammar-aware em dash and en dash replacement',
    'Convert curly smart quotes to straight quotes',
    'Strip zero-width / invisible watermark characters',
    'Clean selection and clean whole note commands',
    'Code-fence protection so snippets are never altered',
    '100% local - no network calls, no telemetry',
  ],
  publisher: { '@id': `${Astro.site}#org` },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const howToSteps = [
  {
    name: 'Install and enable the plugin',
    text: 'Open Settings → Community plugins → Browse, search “Em Dash Remover”, install it and toggle it on (or use the BRAT beta meanwhile).',
  },
  {
    name: 'Paste your AI text',
    text: 'Copy a draft from ChatGPT, Claude or Gemini and paste it into any note — clean-on-paste fixes em dashes, curly quotes, emojis and invisible characters before the text lands.',
  },
  {
    name: 'Read the cleaned toast',
    text: 'A brief notice shows exactly what was removed, so you can see the plugin worked at a glance.',
  },
  {
    name: 'Act on the result',
    text: 'Keep the clean Markdown, hit Undo to restore the original, or run “Scan note for AI tells” to find anything left to fix.',
  },
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to use the Obsidian clean AI paste plugin',
  step: howToSteps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.name,
    text: s.text,
  })),
};
---

<Base
  title="Obsidian Clean AI Paste Plugin - Free, Local & Private"
  description="An Obsidian clean AI paste plugin that strips em dashes, curly quotes, emojis and invisible characters the instant you paste ChatGPT or Claude text. Free, 100% local."
>
  <main class="halo">
    <!-- Editorial header -->
    <header class="mx-auto max-w-3xl px-4 pt-10 pb-6">
      <a href="/tools" class="eyebrow text-accent hover:underline">← All tools</a>
      <p class="eyebrow text-mark mt-6">Copydesk · Obsidian · in development</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">
        Clean AI paste, locally — inside your vault.
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed" style="color: var(--c-ink);">
        An <strong>Obsidian clean AI paste plugin</strong> is a community plugin that automatically removes em dashes, curly quotes, emojis and invisible characters from ChatGPT, Claude or Gemini text the moment you paste it into a note — so your vault stays clean without a single extra keystroke.
      </p>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed muted">
        Paste a draft from ChatGPT, Claude or Gemini into a note and the <strong style="color: var(--c-ink); font-weight: 600;">em dashes, curly quotes and invisible watermark characters</strong> are gone before a single character lands — with the same <strong style="color: var(--c-ink); font-weight: 600;">grammar-aware</strong> cleaning engine as the website, running entirely inside Obsidian. Nothing ever leaves your vault.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <span
          class="inline-flex min-h-11 cursor-not-allowed items-center rounded-xl px-5 font-semibold text-white opacity-60"
          style="background: var(--color-accent);"
          aria-disabled="true"
        >
          Install from Obsidian - coming soon
        </span>
        <a href="/" class="inline-flex min-h-11 items-center rounded-xl px-5 font-medium text-accent hover:underline">
          Use the web tool now →
        </a>
      </div>
    </header>

    <hr class="rule-dash mx-auto mb-2 max-w-3xl" />

    <TrustStrip />

    <!-- What it does -->
    <section class="mx-auto mt-12 max-w-3xl px-4">
      <div class="card p-6 sm:p-8">
        <p class="eyebrow text-mark">In development · features below describe the planned plugin</p>
        <h2 class="mt-2 text-2xl font-bold">What it will do</h2>
        <p class="mt-3 muted">
          The plugin is in development. When you paste text copied from an AI chat
          into a note, it will catch Obsidian’s <code>editor-paste</code> event, run
          the clipboard payload through the same cleaning engine as the website -
          grammar-aware em-dash replacement, en-dash handling, curly → straight
          quotes, ellipsis normalization, zero-width / invisible-char stripping and
          whitespace cleanup - and insert the cleaned Markdown instead of the raw AI
          output. It is also planned to add a <strong>Clean selection</strong>
          command to fix text that’s already in a note, and a
          <strong>bypass paste</strong> for the rare time you want the original
          verbatim. Everything is designed to run locally inside Obsidian, with zero
          network calls - the same local-only story as the web tool, in the place
          you actually draft.
        </p>
      </div>
    </section>

    <!-- Who it's for -->
    <section class="mx-auto mt-12 max-w-3xl px-4">
      <h2 class="text-2xl font-bold">Who it’s for</h2>
      <p class="mt-2 muted">Anyone who drafts in an AI chat and keeps a permanent Obsidian vault:</p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        <li class="card p-4 text-sm muted"><strong style="color: var(--c-ink);">Students &amp; researchers</strong> who paste ChatGPT summaries into study notes and want clean Markdown, not stray em dashes.</li>
        <li class="card p-4 text-sm muted"><strong style="color: var(--c-ink);">Writers &amp; bloggers</strong> who use Obsidian to remove em dash from notes and keep a consistent house style.</li>
        <li class="card p-4 text-sm muted"><strong style="color: var(--c-ink);">PKM &amp; Zettelkasten users</strong> who want to clean up pasted notes automatically and strip emojis from AI text.</li>
        <li class="card p-4 text-sm muted"><strong style="color: var(--c-ink);">Developers &amp; technical note-takers</strong> who need code blocks protected while curly quotes and blank lines get fixed.</li>
        <li class="card p-4 text-sm muted"><strong style="color: var(--c-ink);">Privacy-minded professionals</strong> doing client or legal work who need a clean-paste plugin that works fully offline.</li>
      </ul>
    </section>

    <!-- How to use -->
    <section class="mx-auto mt-12 max-w-3xl px-4">
      <h2 class="text-2xl font-bold">How to use the Obsidian clean AI paste plugin</h2>
      <ol class="mt-4 list-decimal space-y-3 pl-5 muted">
        <li><strong style="color: var(--c-ink);">Install &amp; enable it.</strong> Open <strong>Settings → Community plugins → Browse</strong>, search “Em Dash Remover”, install and toggle it on (or use the BRAT beta meanwhile).</li>
        <li><strong style="color: var(--c-ink);">Paste your AI text.</strong> Copy a draft from ChatGPT, Claude or Gemini and paste it into any note — clean-on-paste fixes em dashes, curly quotes, emojis and invisible characters before the text lands.</li>
        <li><strong style="color: var(--c-ink);">Read the “cleaned” toast.</strong> A brief notice shows exactly what was removed, so you can see the plugin worked at a glance.</li>
        <li><strong style="color: var(--c-ink);">Act on the result.</strong> Keep the clean Markdown, hit <strong>Undo</strong> to restore the original, or run <strong>Scan note for AI tells</strong> to find anything left to fix.</li>
      </ol>
    </section>

    <!-- Features -->
    <section class="mx-auto mt-16 max-w-5xl px-4">
      <h2 class="text-center text-2xl font-bold">Planned features</h2>
      <p class="mx-auto mt-2 max-w-2xl text-center muted">
        Here’s what we’re building. The goal: the best UX is no UI - you paste,
        it’s clean, and everything else is a confirmation, not a step.
      </p>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="card p-5">
            <h3 class="font-semibold">{f.title}</h3>
            <p class="mt-1.5 text-sm muted">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- How it works -->
    <section class="mx-auto mt-20 max-w-4xl px-4">
      <h2 class="text-center text-2xl font-bold">How it will work</h2>
      <p class="mx-auto mt-2 max-w-2xl text-center muted">
        The planned flow, once the plugin ships.
      </p>
      <div class="mt-8 grid gap-5 sm:grid-cols-3">
        {howItWorks.map((s) => (
          <div class="card p-6">
            <span
              class="grid h-9 w-9 place-items-center rounded-full font-bold text-white"
              style="background: var(--color-accent);"
            >{s.step}</span>
            <h3 class="mt-3 font-semibold">{s.title}</h3>
            <p class="mt-1.5 text-sm muted">{s.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Install CTA -->
    <section class="mx-auto mt-20 max-w-3xl px-4">
      <div class="card p-6 text-center sm:p-8">
        <h2 class="text-2xl font-bold">Install</h2>
        <p class="mx-auto mt-3 max-w-xl muted">
          The plugin is heading to the Obsidian community plugin browser. Once it
          passes review you’ll be able to install it from
          <strong>Settings → Community plugins → Browse</strong> and search for
          “Em Dash Remover”. A manual / BRAT beta will land first for early
          adopters.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <span
            class="inline-flex min-h-11 cursor-not-allowed items-center rounded-xl px-5 font-semibold text-white opacity-60"
            style="background: var(--color-accent);"
            aria-disabled="true"
          >
            Coming soon to Community Plugins
          </span>
          <a href="/" class="inline-flex min-h-11 items-center rounded-xl px-5 font-medium text-accent hover:underline">
            Clean text in your browser meanwhile →
          </a>
        </div>
      </div>
    </section>

    <!-- SEO content -->
    <article class="seo mx-auto mt-20 max-w-3xl space-y-5 px-4 leading-relaxed">
      <h2 class="text-2xl font-bold">An Obsidian plugin to remove em dashes and clean AI paste</h2>
      <p class="muted">
        If you brainstorm or draft in ChatGPT or Claude and then paste the result
        into your permanent Obsidian vault, your clean notes end up full of em
        dashes, curly quotes and the occasional invisible watermark character. The
        <strong>Em Dash Remover for Obsidian</strong> plugin is being built to fix
        that at the moment of need - the paste itself - so your vault stays in your
        voice and your punctuation conventions, not the model’s house style.
      </p>

      <h2 class="text-2xl font-bold">Grammar-aware, not a blind find-and-replace</h2>
      <p class="muted">
        An em dash does several jobs. Naive tools swap every one for a comma and
        create comma splices. This plugin is planned to reuse the website’s
        grammar-aware engine to pick a comma, semicolon, colon or spaced hyphen
        based on the surrounding words - and to protect fenced and inline code so
        nothing inside a snippet, JSON blob or shell command is ever touched.
      </p>

      <h2 class="text-2xl font-bold">100% local - your notes never leave your vault</h2>
      <p class="muted">
        Obsidian is a local-first desktop and mobile app, and the plugin is being
        built to keep it that way: no host permissions, no telemetry, no remote
        config, and zero <code>fetch</code> calls. It is designed to read only the
        clipboard payload of the current paste. That is intended to make it safe for
        confidential research, client work and anything you wouldn’t paste into a
        random website - the same local-only approach as the web cleaner, with all
        processing on your device.
      </p>
      <p class="muted">
        Want the same cleanup outside your vault? The <a href="/tools/browser-extension">browser extension to clean em dashes as you type</a> brings clean-on-paste to any text box on the web, while the <a href="/tools/paste-from-word-docs-cleaner">paste-from-Word formatting cleaner</a> handles the messy markup that comes out of Word and Google Docs. For a deeper walkthrough of the problem and the fix, read our guide on <a href="/blog/clean-ai-paste-in-obsidian">how to clean AI paste in Obsidian</a>.
      </p>

      <p class="mt-8 text-xs muted">Last updated: June 2026</p>
    </article>

    <!-- FAQ -->
    <section class="mx-auto mt-16 max-w-3xl px-4">
      <h2 class="text-2xl font-bold">Frequently asked questions</h2>
      <p class="mt-2 text-sm muted">
        The plugin is in development. The answers below describe how it is being
        designed to behave once it ships.
      </p>
      <div class="mt-6 divide-y divide-ink/10">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none font-semibold marker:hidden">
              <span class="inline-flex w-full items-center justify-between">
                {f.q}
                <span class="ml-4 muted transition group-open:rotate-45">+</span>
              </span>
            </summary>
            <p class="mt-2 text-sm muted">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <RelatedTools currentSlug="obsidian-plugin" />

    <script type="application/ld+json" set:html={JSON.stringify(softwareApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  </main>

  <style is:global>
    @media (max-width: 767px) { body { padding-bottom: 4.5rem; } }
    .seo a { color: var(--color-accent); text-decoration: underline; }
    .seo code { font-family: var(--font-mono); font-size: 0.9em; }
  </style>
</Base>
