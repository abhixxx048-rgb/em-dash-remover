---
import Base from '../../layouts/Base.astro';
import BeforeAfterDiffViewer from '../../components/tools/BeforeAfterDiffViewer.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const faqs = [
  {
    q: 'What is a diff checker and how does it work?',
    a: 'A diff checker is a tool that compares two texts and highlights the differences between them. You paste an original and a changed version, and it lines them up, then marks added words in green, deleted words in red, and unchanged text neutrally - so you can see exactly what changed at a glance.',
  },
  {
    q: 'How do I compare two texts for differences?',
    a: 'Paste your original text into the left box and the edited version into the right box. The diff appears instantly and recomputes as you type. Switch between inline and side-by-side views, and word-level or character-level diffing, to read the changes the way that suits you best.',
  },
  {
    q: 'Can I compare text without uploading to a server?',
    a: 'Yes. The diff is computed entirely in your browser with JavaScript - your original and changed text never leave your device. Open your browser DevTools Network tab while you use it and you will see zero requests with your text. It even works offline, which makes it safe for confidential legal, medical, or financial copy.',
  },
  {
    q: 'Is there a free way to compare two texts online with no signup?',
    a: 'This text diff checker is completely free, needs no signup or registration, and shows no ads. It runs client-side in your browser, so there is no account to create and nothing to install - a private alternative to upload-based compare tools.',
  },
  {
    q: 'How can I tell what ChatGPT changed in my writing?',
    a: 'Paste your original draft on the left and the AI-rewritten version on the right. The viewer redlines every difference so you can compare ChatGPT-edited text with the original and review AI edits before keeping them - accepting the improvements you like and rejecting the rest.',
  },
  {
    q: "What's the difference between word-level and character-level diff?",
    a: 'Word-level diff highlights whole words that changed, which reads cleanly for prose - ideal for checking that a cleanup did not alter your meaning. Character-level diff highlights the exact characters that changed, which is best for inspecting fine punctuation like a single em dash turning into a comma. Switch between them with the Word / Character toggle.',
  },
  {
    q: 'Can I undo a change after I accept it?',
    a: 'Yes. Every change is a reversible unit. Click ↩ to keep the original or ✓ to use the cleaned version, and switch back at any time. There are also Accept all and Reject all buttons. Rejecting restores your exact original substring, so reject-all gives you back your text untouched.',
  },
  {
    q: "Can I compare two texts that didn't come from the cleaner?",
    a: 'Absolutely. Paste any two pieces of text into the Original and Changed boxes - release-note versions, microcopy variants, prompt revisions, or two drafts of an essay. The viewer works as a standalone before-and-after text compare tool, not only for cleaner output.',
  },
  {
    q: "Why are some 'invisible' changes shown as chips?",
    a: 'Zero-width and non-breaking characters are literally invisible, so a removed one would look like nothing changed. To make those edits visible we render them as labelled chips such as [ZWSP] or ␣ inside the diff, so you can actually see the invisible AI artifacts that were removed.',
  },
  {
    q: 'Does it work on mobile?',
    a: 'Yes. The inline view is the default on phones, the accept/reject controls are tap-sized, and a Text / Diff switcher lets you flip between your inputs and the result. Side-by-side is available too and scrolls horizontally on narrow screens.',
  },
];

const webApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${Astro.site}tools/before-after-diff-viewer#app`,
  name: 'Before/After Diff Viewer',
  url: `${Astro.site}tools/before-after-diff-viewer`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web Browser',
  browserRequirements: 'Requires JavaScript.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  isAccessibleForFree: true,
  dateModified: '2026-06-15',
  featureList: [
    'Compare before and after text instantly',
    'Inline and side-by-side diff views',
    'Word-level and character-level diffing',
    'Per-change accept and reject - keep your voice',
    'Highlight invisible / zero-width characters',
    '100% private - no upload, runs in your browser',
  ],
  publisher: { '@id': `${Astro.site}#org` },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to compare two texts and highlight differences',
  step: [
    { '@type': 'HowToStep', name: 'Paste your two texts', text: 'Paste your original text into the left box and the changed or edited version into the right box.' },
    { '@type': 'HowToStep', name: 'Choose view and diff level', text: 'Pick inline or side-by-side view and word-level or character-level diffing to compare the two texts the way you prefer.' },
    { '@type': 'HowToStep', name: 'Review the differences', text: 'Read every highlighted difference: added words appear in green, deleted words in red, and invisible characters show as labelled chips.' },
    { '@type': 'HowToStep', name: 'Accept or reject each change', text: 'Use the per-change controls to keep your original wording or use the cleaned version, change by change.' },
    { '@type': 'HowToStep', name: 'Copy the result', text: 'Copy or download the merged result once you are happy. Everything runs in your browser, so nothing is uploaded.' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Text Diff Checker - Compare Two Texts Free, No Signup"
  description="Free online text diff checker to compare two texts and highlight differences. Side-by-side or inline, accept or reject each change. Private, in-browser, no signup."
>
  <main class="halo">
    <!-- Editorial header -->
    <header class="tool-head mx-auto max-w-3xl px-4 pt-10 pb-6">
      <a href="/tools" class="back-note inline-flex min-h-11 items-center text-accent hover:underline">&larr; All tools</a>
      <p class="eyebrow mt-4 text-mark">Compare &middot; Free &middot; In your browser</p>
      <h1 class="mt-2 text-4xl sm:text-5xl">
        Text Diff Checker
      </h1>
      <p class="definition mt-4 max-w-2xl">
        A text diff checker is a tool that compares two texts and highlights the
        differences between them, showing exactly which words and characters were
        added, removed, or changed.
      </p>
      <p class="lede mt-4 max-w-2xl">
        Compare two versions of text side by side or inline. Every word, em
        dash, quote, and invisible character is marked up &mdash; and you decide,
        change by change, whether to <strong>keep the original or use the
        cleaned version</strong>. Compare original and edited text, keep your
        human voice.
      </p>
    </header>

    <hr class="rule-dash mx-auto max-w-3xl px-4" />

    <BeforeAfterDiffViewer />

    <TrustStrip />

    <!-- Who it's for -->
    <section class="mx-auto mt-20 max-w-3xl px-4">
      <p class="eyebrow text-mark">Who it's for</p>
      <h2 class="mt-2 text-2xl font-bold">Built for anyone reviewing two versions of text</h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        <li class="card p-4 text-sm muted"><strong>Writers &amp; editors</strong> comparing before and after versions of an essay or draft, change by change.</li>
        <li class="card p-4 text-sm muted"><strong>Students</strong> who want to compare two versions of text online and see exactly what an edit changed.</li>
        <li class="card p-4 text-sm muted"><strong>SEO &amp; content teams</strong> reviewing microcopy variants, redlining headlines, and tracking edits.</li>
        <li class="card p-4 text-sm muted"><strong>Developers</strong> wanting a git-style diff viewer for plain text, release notes, and prompt revisions.</li>
        <li class="card p-4 text-sm muted"><strong>AI-edit reviewers</strong> who need to compare ChatGPT-edited text with the original and review AI edits before keeping them.</li>
      </ul>
    </section>

    <!-- How to use -->
    <section class="mx-auto mt-16 max-w-3xl px-4">
      <p class="eyebrow text-mark">How to use</p>
      <h2 class="mt-2 text-2xl font-bold">How to compare two texts and highlight differences</h2>
      <ol class="how-steps mt-5 list-decimal space-y-3 pl-6 muted">
        <li><strong>Paste your original text</strong> into the left (Original) box and the changed or edited version into the right (Changed) box.</li>
        <li><strong>Choose your view and diff level</strong> &mdash; inline or side-by-side, and word-level or character-level &mdash; to compare the two texts the way you prefer.</li>
        <li><strong>Review every highlighted difference</strong>: added words appear in green, deleted words in red, and invisible characters show as labelled chips.</li>
        <li><strong>Accept or reject each change</strong> with ↩ / ✓ to keep your original wording or use the cleaned version.</li>
        <li><strong>Copy or download the merged result</strong> once you are happy &mdash; everything runs in your browser, so nothing is uploaded.</li>
      </ol>
    </section>

    <!-- SEO content -->
    <article class="seo mx-auto mt-20 max-w-3xl space-y-5 px-4 leading-relaxed">
      <p class="eyebrow text-mark">The long version</p>
      <hr class="rule-dash" />
      <h2 class="text-2xl font-bold">Compare your original and cleaned text instantly</h2>
      <p class="muted">
        Bulk find-and-replace tools are scary because they change your prose
        silently. A before-and-after diff viewer removes that fear: it shows
        every edit before you commit it. Paste your original on the left and the
        cleaned or edited version on the right, and the diff appears instantly -
        recomputing as you type. Deletions are shown struck through in red,
        insertions underlined in green, and unchanged text stays neutral, so you
        can read the change at a glance. For a step-by-step walkthrough, see our
        guide on <a href="/blog/how-to-compare-two-versions-of-text">how to compare two versions of text</a>.
      </p>

      <h2 class="text-2xl font-bold">Inline vs side-by-side: pick your view</h2>
      <p class="muted">
        <strong>Inline</strong> view merges both versions into one column - the
        lowest-effort way to read a change in context, and the default on mobile.
        <strong>Side-by-side</strong> view aligns the original and the result in
        two gutter-numbered columns, the way editors and developers expect to
        compare versions. Your choice is remembered for next time. Both views
        render invisible characters as visible chips like <code>[ZWSP]</code> so
        nothing hides from you.
      </p>

      <h2 class="text-2xl font-bold">Accept or reject every change - keep your voice</h2>
      <p class="muted">
        This is track-changes without Microsoft Word and without uploading a
        thing. Each change is its own reviewable unit: click ↩ to keep your
        original wording or ✓ to use the cleaned version. Filter by change type -
        dashes, quotes, ellipses, invisibles, whitespace, markdown - to scrutinise
        one category while accepting the rest. Power users can navigate with
        <code>j</code> / <code>k</code> and accept or reject with <code>a</code> /
        <code>r</code>. When you are done, copy or download the merged result.
        Reject everything and you get your exact original back - nothing is ever
        forced on you.
      </p>

      <h2 class="text-2xl font-bold">Word-level vs character-level diff (what's the difference?)</h2>
      <p class="muted">
        <strong>Word-level</strong> diffing groups changes by whole words, which
        reads naturally for prose and is the right default for verifying meaning.
        <strong>Character-level</strong> diffing pinpoints the exact characters
        that changed - perfect for inspecting a lone em dash becoming a comma or a
        curly quote turning straight. Toggle between them live; the diff recomputes
        without leaving the page.
      </p>

      <h2 class="text-2xl font-bold">100% private: your text never leaves your browser</h2>
      <p class="muted">
        Several popular compare tools offer "save online and share a URL," which
        quietly sends your text to a server. This viewer never does. All diffing,
        classification, accept/reject merging, and export run in your browser with
        zero network calls - a direct answer to searches for a private, no-upload,
        offline text diff checker. It is safe for sensitive documents and works
        with no internet connection at all. Pair it with the
        <a href="/tools/paste-from-word-docs-cleaner">paste-from-Word cleaner</a>
        to strip formatting soup before you compare, or the
        <a href="/tools/whitespace-line-break-reflow-fixer">whitespace and reflow fixer</a>
        to unwrap hard-wrapped text so your diff stays readable.
      </p>
    </article>

    <!-- FAQ -->
    <section class="faq-block mx-auto mt-16 max-w-3xl px-4">
      <p class="eyebrow text-mark">In the margin</p>
      <h2 class="text-2xl font-bold">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-ink/10">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none font-semibold marker:hidden">
              <span class="inline-flex w-full items-center justify-between">
                {f.q}
                <span class="ml-4 muted transition group-open:rotate-45">+</span>
              </span>
            </summary>
            <p class="mt-2 text-sm muted">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <RelatedTools currentSlug="before-after-diff-viewer" />

    <p class="mx-auto mt-10 max-w-3xl px-4 text-xs muted">Last updated: June 2026</p>

    <script type="application/ld+json" set:html={JSON.stringify(webApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </main>

  <style is:global>
    @media (max-width: 767px) { body { padding-bottom: 4.5rem; } }
    .seo a { color: var(--color-accent); text-decoration: underline; }
    .seo code { font-family: var(--font-mono); font-size: 0.9em; background: var(--c-accent-soft); padding: 0 0.3em; border-radius: 4px; }

    /* Editorial header + section rhythm (shared across tool pages) */
    .tool-head .back-note { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
    .tool-head h1 { line-height: 1.05; }
    .tool-head .lede { font-size: 1.2rem; line-height: 1.6; color: var(--c-muted); }
    .tool-head .definition { font-size: 1.05rem; line-height: 1.55; color: var(--c-muted); }
    .how-steps li::marker { color: var(--color-accent); font-weight: 700; }
    .seo h2, .faq-block h2 { font-family: var(--font-display); font-size: 1.6rem; line-height: 1.15; margin-top: 0.25rem; }
    .seo h2 + p, .seo h2 + ol, .seo h2 + ul { margin-top: 0.6rem; }
  </style>
</Base>
