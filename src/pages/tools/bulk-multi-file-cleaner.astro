---
import Base from '../../layouts/Base.astro';
import BulkMultiFileCleaner from '../../components/tools/BulkMultiFileCleaner.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import TrustStrip from '../../components/TrustStrip.astro';

const faqs = [
  {
    q: 'What is a bulk text cleaner?',
    a: 'A bulk text cleaner is a tool that cleans many text files in one pass instead of pasting them one at a time. You drop a whole folder of .txt or .md files and each one is normalized with the same rules - removing em dashes, smart quotes and invisible characters - then handed back with a per-file report and individual downloads.',
  },
  {
    q: 'How do I clean multiple text files at once?',
    a: 'Select a whole folder of files in the picker, or drag a multi-file selection onto the page. Every file is cleaned with identical grammar-aware rules and gets its own row in the report, so you clean multiple text files at once and download the results without re-pasting anything.',
  },
  {
    q: 'Can you clean files without uploading them?',
    a: 'Yes. Every file is read and cleaned entirely in your browser with plain JavaScript and the FileReader API - nothing is uploaded, stored or logged. Open your DevTools Network tab while you use it and you will see zero requests. The tool also works fully offline, which is the whole point for confidential drafts.',
  },
  {
    q: 'How do I remove em dashes from multiple files?',
    a: 'Drop the files, keep Smart mode on and run the batch. Each file has its em dashes replaced with a grammar-aware comma, semicolon, colon, period or parentheses, so you remove em dashes from multiple files at once without introducing comma splices the way a blind find-and-replace would.',
  },
  {
    q: 'How many files can I clean at once?',
    a: 'As many as your browser can hold in memory. Select a folder in the picker or drag a multi-file selection onto the page, and each file is cleaned and gets its own report row. Very large individual files are skipped with a clear note so one giant file never stalls the batch.',
  },
  {
    q: 'How do I remove smart quotes from multiple files?',
    a: 'Smart quotes are handled automatically in every file of the batch: curly "smart" quotes and apostrophes are converted to straight ones alongside the em dash, en dash, ellipsis and invisible-character cleanup. There is no extra setting to enable - run the batch and each file comes back with straight quotes.',
  },
  {
    q: 'Which file formats are supported?',
    a: 'Right now: plain text (.txt) and Markdown (.md, .markdown, .mdx). Word .docx and .zip archives are recognised and shown as "coming soon" rather than silently dropped - repacking a valid .docx in the browser needs an extra library we have not bundled yet, so we feature-detect and tell you instead of producing a broken file.',
  },
  {
    q: 'How do I download multiple cleaned files at once?',
    a: '"Download all cleaned" saves every cleaned and already-clean file in one go, keeping the original names with a -clean suffix. You can also download any single file from its row, and export a CSV report of exactly what was normalized to show a client or teammate.',
  },
  {
    q: 'Does it strip my Markdown formatting?',
    a: 'Only if you turn on the "Strip markdown" option. It is off by default precisely so cleaning a folder of .md files does not destroy your intentional headings, bold and code. Leave it off to keep your Markdown; turn it on when you are flattening AI output into plain prose.',
  },
];

const webApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${Astro.site}tools/bulk-multi-file-cleaner#app`,
  name: 'Bulk Text Cleaner - Clean Multiple Files at Once',
  url: `${Astro.site}tools/bulk-multi-file-cleaner`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web Browser',
  browserRequirements: 'Requires JavaScript.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  isAccessibleForFree: true,
  dateModified: '2026-06-15',
  featureList: [
    'Bulk text cleaner for multiple files',
    'Clean multiple .txt and .md files at once',
    'Remove em dashes from many files in one pass',
    'Batch remove invisible / watermark characters',
    'Grammar-aware em dash replacement across a whole folder',
    'Per-file cleanup report with counts',
    'Download cleaned files individually',
    '100% in your browser - files never uploaded',
  ],
  publisher: { '@id': `${Astro.site}#org` },
};

const howToSteps = [
  {
    name: 'Add your files',
    text: 'Select a whole folder in the file picker or drag and drop multiple .txt and .md files onto the page. Nothing is uploaded - each file is read locally with your browser.',
  },
  {
    name: 'Configure the cleanup',
    text: 'Keep grammar-aware Smart mode on to remove em dashes correctly, and toggle options like "Strip markdown" if you are flattening AI output into plain prose.',
  },
  {
    name: 'Clean the batch',
    text: 'Run the batch to clean multiple files at once. Each file is normalized with identical rules and gets its own row showing how many em dashes, smart quotes and invisible characters were fixed.',
  },
  {
    name: 'Download the results',
    text: 'Download any single cleaned file from its row, or use "Download all cleaned" to save the whole set at once with a -clean suffix. Export a CSV report if you need to show exactly what changed.',
  },
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to clean multiple text files at once',
  step: howToSteps.map((s) => ({
    '@type': 'HowToStep',
    name: s.name,
    text: s.text,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Bulk Text Cleaner for Multiple Files - Free, In-Browser"
  description="Free bulk text cleaner for multiple files: drop a folder of .txt and .md files and remove em dashes, smart quotes and invisible characters from every one. No upload, no signup, 100% in your browser."
>
  <main class="halo">
    <!-- Editorial header -->
    <header class="tool-head mx-auto max-w-3xl px-4 pt-10 pb-6">
      <a href="/tools" class="back-note inline-flex min-h-11 items-center text-accent hover:underline">&larr; All tools</a>
      <p class="eyebrow mt-4 text-mark">Batch cleanup &middot; Free &middot; In your browser</p>
      <h1 class="mt-2 text-4xl sm:text-5xl">
        Bulk Text Cleaner for Multiple Files
      </h1>
      <p class="def mt-4 max-w-2xl">
        A <strong>bulk text cleaner for multiple files</strong> is a tool that cleans
        many text files in a single pass &mdash; removing em dashes, smart quotes and
        invisible characters from every file at once instead of pasting them one by one.
      </p>
      <p class="lede mt-3 max-w-2xl">
        Drop a whole folder of <code>.txt</code> and <code>.md</code> files and
        clean every one with the same <strong>grammar-aware</strong> rules as the
        single-paste tool &mdash; em dashes, smart quotes, invisible characters and
        more. You get a per-file report and can download each cleaned file. Your
        files never leave your browser.
      </p>
    </header>

    <hr class="rule-dash mx-auto max-w-3xl px-4" />

    <BulkMultiFileCleaner />

    <TrustStrip />

    <!-- Value props -->
    <section class="prop-grid mx-auto mt-16 max-w-5xl px-4">
      <p class="eyebrow text-mark">Why a batch tool</p>
      <div class="mt-4 grid gap-6 sm:grid-cols-3">
        <div class="card p-5">
          <p class="eyebrow muted">01</p>
          <h2 class="mt-2 font-semibold">A folder in, a clean folder out</h2>
          <p class="mt-1.5 text-sm muted">Pick many files at once instead of re-pasting one at a time. Every file is cleaned with identical rules and gets its own download.</p>
        </div>
        <div class="card p-5">
          <p class="eyebrow muted">02</p>
          <h2 class="mt-2 font-semibold">Your files never leave your browser</h2>
          <p class="mt-1.5 text-sm muted">Read and cleaned on-device with FileReader - no upload, no server, no logging. Check the Network tab. Safe for confidential manuscripts and client work.</p>
        </div>
        <div class="card p-5">
          <p class="eyebrow muted">03</p>
          <h2 class="mt-2 font-semibold">Grammar-aware, not blind replace</h2>
          <p class="mt-1.5 text-sm muted">Smart mode picks a comma, semicolon, colon or parentheses per sentence - so a batch of files never comes back full of comma splices.</p>
        </div>
      </div>
    </section>

    <!-- Who it's for -->
    <section class="mx-auto mt-16 max-w-3xl px-4">
      <p class="eyebrow text-mark">Who it's for</p>
      <p class="mt-3 text-sm muted max-w-2xl">
        Built for anyone who ends up with a folder of files to clean instead of a single paste:
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="inline-block rounded-full px-3 py-1 text-xs font-semibold text-accent" style="background: var(--c-accent-soft);">Writers cleaning a batch of AI-drafted chapters</span>
        <span class="inline-block rounded-full px-3 py-1 text-xs font-semibold text-accent" style="background: var(--c-accent-soft);">SEO teams normalizing many blog posts</span>
        <span class="inline-block rounded-full px-3 py-1 text-xs font-semibold text-accent" style="background: var(--c-accent-soft);">Students tidying multiple essays and notes</span>
        <span class="inline-block rounded-full px-3 py-1 text-xs font-semibold text-accent" style="background: var(--c-accent-soft);">Editors &amp; VAs handling client manuscripts privately</span>
        <span class="inline-block rounded-full px-3 py-1 text-xs font-semibold text-accent" style="background: var(--c-accent-soft);">Developers cleaning Markdown docs in bulk</span>
      </div>
    </section>

    <!-- How to use -->
    <section class="mx-auto mt-16 max-w-3xl px-4">
      <p class="eyebrow text-mark">How to use it</p>
      <h2 class="mt-2 text-2xl font-bold">How to clean multiple files at once</h2>
      <ol class="mt-4 list-decimal space-y-3 pl-5 text-sm muted">
        {howToSteps.map((s) => (
          <li><strong class="text-ink">{s.name}.</strong> {s.text}</li>
        ))}
      </ol>
    </section>

    <!-- SEO content -->
    <article class="seo mx-auto mt-20 max-w-3xl space-y-5 px-4 leading-relaxed">
      <p class="eyebrow text-mark">The long version</p>
      <hr class="rule-dash" />
      <h2 class="text-2xl font-bold">Clean multiple text files at once</h2>
      <p class="muted">
        Most AI text cleaners are paste-box only: one document at a time, copy,
        clean, paste back, repeat. If you just had ChatGPT or Claude draft twenty
        blog posts, product descriptions or chapters, that is twenty round trips.
        This <strong>bulk text cleaner</strong> takes the whole set at once -
        select a folder in the picker or drag many files onto the page - and runs
        the same de-AI cleaning engine over each file locally, so the output
        matches the single-paste tool exactly. For a deeper walkthrough, see our guide on
        <a href="/blog/how-to-clean-multiple-files-at-once">how to clean multiple files at once</a>.
      </p>

      <h2 class="text-2xl font-bold">What it cleans in every file</h2>
      <p class="muted">
        Each file passes through the same rules: it removes em dashes with a
        grammar-aware replacement, normalizes en dashes, converts curly
        &ldquo;smart&rdquo; quotes and apostrophes to straight ones, expands the
        ellipsis character (…) to three dots, strips non-breaking spaces and
        invisible zero-width &ldquo;watermark&rdquo; characters, and can optionally
        remove leftover Markdown. The per-file report shows a count of each artifact
        so you can <strong>batch remove invisible characters</strong> and other AI
        formatting and see exactly how much was cleaned. If you want to audit a single
        file first, the
        <a href="/tools/invisible-watermark-character-inspector">invisible watermark character inspector</a>
        shows every hidden character before you run the full batch.
      </p>

      <h2 class="text-2xl font-bold">100% in your browser - files never uploaded</h2>
      <p class="muted">
        Dropping a folder of client manuscripts or confidential drafts onto a
        website is exactly the moment people fear an upload. Here there is none.
        Every file is read with the browser&rsquo;s FileReader API and cleaned with
        plain JavaScript - there is no <code>fetch</code>, no server and no LLM in
        the loop. Open DevTools, watch the Network tab, then turn off your
        Wi-Fi: it keeps working. For legal, medical, HR and academic users, that
        provable, offline guarantee is the deciding feature, not decoration.
      </p>

      <h2 class="text-2xl font-bold">Download cleaned files and a cleanup report</h2>
      <p class="muted">
        When the batch finishes you can download any single file from its row, or
        hit <strong>Download all cleaned</strong> to save the whole set at once -
        original names preserved with a <code>-clean</code> suffix so you always
        know which file is which. You can also copy or download a CSV report of
        exactly what was normalized in each file, which is handy when an editor or
        VA needs to show a client what changed. Word <code>.docx</code> and
        <code>.zip</code> support is on the roadmap; those files are recognised and
        flagged &ldquo;coming soon&rdquo; rather than mangled. For pasted Word or Google
        Docs content rather than whole files, the
        <a href="/tools/paste-from-word-docs-cleaner">paste-from-Word docs cleaner</a>
        strips the same formatting soup from a single paste.
      </p>
    </article>

    <!-- FAQ -->
    <section class="faq-block mx-auto mt-16 max-w-3xl px-4">
      <p class="eyebrow text-mark">In the margin</p>
      <h2 class="text-2xl font-bold">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-ink/10">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none font-semibold marker:hidden">
              <span class="inline-flex w-full items-center justify-between">
                {f.q}
                <span class="ml-4 muted transition group-open:rotate-45">+</span>
              </span>
            </summary>
            <p class="mt-2 text-sm muted">{f.a}</p>
          </details>
        ))}
      </div>
      <p class="mt-6 text-xs muted">Last updated: June 2026</p>
    </section>

    <RelatedTools currentSlug="bulk-multi-file-cleaner" />

    <script type="application/ld+json" set:html={JSON.stringify(webApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </main>

  <!-- Clear the fixed mobile action bar so the footer is reachable. -->
  <style is:global>
    @media (max-width: 767px) { body { padding-bottom: 4.5rem; } }
    .seo a { color: var(--color-accent); text-decoration: underline; }

    /* Editorial header + section rhythm (shared across tool pages) */
    .tool-head .back-note { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
    .tool-head h1 { line-height: 1.05; }
    .tool-head .lede { font-size: 1.2rem; line-height: 1.6; color: var(--c-muted); }
    .tool-head .def { font-size: 1.05rem; line-height: 1.55; }
    .seo h2, .faq-block h2 { font-family: var(--font-display); font-size: 1.6rem; line-height: 1.15; margin-top: 0.25rem; }
    .seo h2 + p, .seo h2 + ol, .seo h2 + ul { margin-top: 0.6rem; }
  </style>
</Base>
