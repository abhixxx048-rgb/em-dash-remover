---
import Base from '../../layouts/Base.astro';

// The tool hub. Hub-and-spoke internal linking: every tool page links back here,
// and this page links out to all of them (see RESEARCH.md SEO strategy).
const tiers = [
  {
    name: 'Clean & convert',
    blurb: 'Everyday cleanup and conversion — the marks an editor makes first, each running entirely in your browser.',
    tools: [
      { href: '/tools/invisible-watermark-character-inspector', icon: '👻', title: 'Invisible Character Inspector', desc: 'See and strip hidden zero-width, watermark and bidi characters.' },
      { href: '/tools/word-reading-time-counter', icon: '🔢', title: 'Word & Reading-Time Counter', desc: 'Live word, character, sentence counts, reading time and platform limits.' },
      { href: '/tools/before-after-diff-viewer', icon: '🔬', title: 'Before/After Diff Viewer', desc: 'Compare original vs cleaned text with per-change accept/reject.' },
      { href: '/tools/readability-grade-level-scorer', icon: '📊', title: 'Readability Scorer', desc: 'Flesch, Flesch-Kincaid, Gunning Fog grade levels and hard sentences.' },
      { href: '/tools/emoji-decorative-symbol-stripper', icon: '🚫', title: 'Emoji & Symbol Stripper', desc: 'Remove emoji and decorative bullets while keeping meaningful symbols.' },
      { href: '/tools/case-converter', icon: '🔠', title: 'Case Converter', desc: 'UPPER, lower, Sentence, Title (AP/Chicago) and developer cases.' },
      { href: '/tools/whitespace-line-break-reflow-fixer', icon: '↹', title: 'Whitespace & Reflow Fixer', desc: 'Collapse spaces and unwrap hard-wrapped PDF/email text into paragraphs.' },
      { href: '/tools/paste-from-word-docs-cleaner', icon: '📋', title: 'Paste-from-Word Cleaner', desc: 'Strip Word/Docs formatting soup, keep real paragraphs.' },
      { href: '/tools/straight-to-curly-quotes-converter', icon: '“”', title: 'Straight-to-Curly Quotes', desc: 'Add correct curly quotes, apostrophes and proper dashes for publishing.' },
      { href: '/tools/sentence-splitter', icon: '✂️', title: 'Sentence Splitter', desc: 'One sentence per line with a cadence chart for auditing rhythm.' },
    ],
  },
  {
    name: 'Analyze & improve',
    blurb: 'Read the draft the way an editor reads it — find what makes writing sound like AI, then fix it for quality, not detector-bypass.',
    tools: [
      { href: '/tools/human-voice-ai-tell-report', icon: '🫀', title: 'Human-Voice / AI-Tell Report', desc: 'Flag cadence, clichés and patterns that make a draft read like AI.' },
      { href: '/tools/homoglyph-confusables-detector', icon: '🕵️', title: 'Homoglyph Detector', desc: 'Find Cyrillic/Greek look-alike characters hiding in Latin text.' },
      { href: '/tools/passive-voice-weasel-word-highlighter', icon: '🎯', title: 'Passive-Voice Highlighter', desc: 'Highlight passive voice, weak adverbs and weasel words.' },
      { href: '/tools/read-aloud-proofreader', icon: '🔊', title: 'Read-Aloud Proofreader', desc: 'Hear your text read aloud to catch run-ons and missing words.' },
      { href: '/tools/local-voice-style-memory', icon: '🧠', title: 'Voice / Style Memory', desc: 'Build a private style profile and flag where a draft stops sounding like you.' },
    ],
  },
  {
    name: 'Power tools & apps',
    blurb: 'Bigger workflows and companion apps for the whole desk — still 100% on your device.',
    tools: [
      { href: '/tools/bulk-multi-file-cleaner', icon: '🗂️', title: 'Bulk / Multi-File Cleaner', desc: 'Drop multiple files, clean each in-browser, download the results.' },
      { href: '/tools/on-device-ai-rewrite', icon: '✨', title: 'On-Device AI Rewrite', desc: 'One-click tone/length rewrite via your browser’s built-in AI.' },
      { href: '/tools/webgpu-webllm-rewrite', icon: '⚡', title: 'WebGPU Rewrite', desc: 'Experimental on-device rewrite that never uploads your text.' },
      { href: '/tools/browser-extension', icon: '🧩', title: 'Browser Extension', desc: 'Clean em dashes and AI tells in place, anywhere you type.' },
      { href: '/tools/obsidian-plugin', icon: '🔮', title: 'Obsidian Plugin', desc: 'Clean AI-chat pastes automatically inside your Obsidian vault.' },
    ],
  },
];

const total = tiers.reduce((n, t) => n + t.tools.length, 0);

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Free AI Text Cleanup Tools',
  url: new URL('/tools', Astro.site).href,
  isPartOf: { '@id': `${Astro.site}#website` },
  hasPart: tiers.flatMap((t) =>
    t.tools.map((tool) => ({
      '@type': 'WebApplication',
      name: tool.title,
      url: new URL(tool.href, Astro.site).href,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web Browser',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    }))
  ),
};

// Continuous numbering across groups, like entries in a galley index.
let entry = 0;
const groups = tiers.map((tier) => ({
  ...tier,
  tools: tier.tools.map((tool) => ({ ...tool, n: ++entry })),
}));
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  title="Free AI Text Cleanup Tools - No Signup, 100% In-Browser"
  description={`${total} free tools to clean, convert and improve AI and human writing - remove invisible characters, count words, check readability, strip emoji and more. Every tool runs entirely in your browser.`}
>
  <main class="halo">
    <header class="mx-auto max-w-3xl px-4 pt-12 pb-6 sm:pt-16">
      <p class="eyebrow text-mark">The desk · {total} tools, no signup</p>
      <h1 class="mt-4 text-4xl sm:text-5xl">The toolkit</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed muted">
        Every instrument on the copyeditor’s desk — for cleaning, converting and
        reading your writing the way an editor would. Each one runs entirely on
        your device. Your text never leaves the browser.
      </p>
      <p class="eyebrow muted mt-6">
        <a href="/" class="text-accent hover:underline">← Back to the Em Dash Remover</a>
      </p>
    </header>

    <div class="mx-auto max-w-3xl px-4">
      <hr class="rule-dash" />
    </div>

    {groups.map((group, i) => (
      <section class="mx-auto max-w-3xl px-4">
        <div class="pt-10 sm:pt-12">
          <p class="eyebrow text-mark">{pad(i + 1)} · {group.tools.length} entries</p>
          <h2 class="mt-2 text-2xl sm:text-3xl">{group.name}</h2>
          <p class="mt-2 max-w-2xl text-base leading-relaxed muted">{group.blurb}</p>
        </div>

        <ul class="mt-7">
          {group.tools.map((tool) => (
            <li>
              <a
                href={tool.href}
                class="tool-row group flex items-baseline gap-4 py-4"
                style="text-decoration: none;"
              >
                <span class="eyebrow tool-no shrink-0" style="color: var(--c-muted);">{pad(tool.n)}</span>
                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                    <span class="tool-title text-lg font-semibold group-hover:text-accent" style="font-family: var(--font-display);">{tool.title}</span>
                    <span aria-hidden="true" class="tool-emoji text-sm opacity-70">{tool.icon}</span>
                  </span>
                  <span class="mt-1 block text-sm leading-relaxed muted">{tool.desc}</span>
                </span>
                <span aria-hidden="true" class="tool-arrow eyebrow shrink-0 self-center text-accent">→</span>
              </a>
            </li>
          ))}
        </ul>

        {i < groups.length - 1 && <hr class="rule-dash mt-6" />}
      </section>
    ))}

    <div class="mx-auto max-w-3xl px-4">
      <hr class="rule-dash mt-12" />
    </div>

    <section class="mx-auto max-w-3xl px-4 pb-20">
      <div class="card mt-12 p-6 sm:p-7">
        <p class="eyebrow text-mark">Margin note</p>
        <p class="mt-3 text-base leading-relaxed">
          Every tool here is 100% client-side. Open your browser’s DevTools →
          Network while you use any of them and you’ll see zero requests. They
          even work offline.
        </p>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </main>
</Base>

<style>
  /* Index rows: a ruled ledger of entries, hairline between each. */
  .tool-row {
    border-top: 1px solid color-mix(in srgb, var(--c-ink) 10%, transparent);
    transition: background-color 0.15s ease, padding-left 0.15s ease;
    padding-inline: 0.5rem;
    margin-inline: -0.5rem;
    border-radius: 6px;
  }
  ul > li:last-child .tool-row {
    border-bottom: 1px solid color-mix(in srgb, var(--c-ink) 10%, transparent);
  }
  .tool-row:hover {
    background: var(--c-accent-soft);
    padding-left: 0.85rem;
  }
  .tool-no {
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    padding-top: 0.15rem;
  }
  .tool-arrow {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .tool-row:hover .tool-arrow,
  .tool-row:focus-visible .tool-arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>
