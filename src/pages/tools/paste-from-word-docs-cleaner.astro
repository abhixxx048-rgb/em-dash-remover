---
import Base from '../../layouts/Base.astro';
import PasteFromWordDocsCleaner from '../../components/tools/PasteFromWordDocsCleaner.astro';

const faqs = [
  {
    q: 'Does this upload my document anywhere?',
    a: 'No. The tool reads what your clipboard carries and cleans it entirely in your browser with JavaScript. Nothing is uploaded, stored, or logged. Open DevTools → Network while you paste and you will see zero requests — it even works offline.',
  },
  {
    q: 'What is mso- / MsoNormal and why is it in my paste?',
    a: 'When you copy from Microsoft Word, the clipboard carries a hidden rich-HTML version of your text full of Word-specific styling: mso- inline styles, MsoNormal classes, <o:p> tags and <xml> islands. Web editors do not understand any of it, so it shows up as broken fonts and spacing. We strip all of it while keeping your real paragraphs, headings, lists and links.',
  },
  {
    q: 'Will it keep my headings, bold text, and links?',
    a: 'Yes, by default. The cleaner uses a structure allow-list, so paragraphs, headings, lists, bold, italic and links survive while the invisible styling is removed. Choose the "Plain text" preset to flatten everything to clean prose, or toggle individual keeps (bold, links, lists, headings, tables).',
  },
  {
    q: 'Why does copying from a PDF add line breaks and split words?',
    a: 'PDFs store text by its visual position on the page, not as flowing paragraphs. So a copy brings one line break per visual row, and words that wrapped mid-line come across hyphenated (com-\\npany). Turn on "Repair PDF line breaks" and we de-hyphenate split words and reflow soft breaks back into real paragraphs, while keeping blank-line paragraph boundaries and list items intact.',
  },
  {
    q: 'Can I get clean Markdown instead of HTML?',
    a: 'Yes. Switch the output to Markdown (or press Ctrl/Cmd+Shift+M) and you get GitHub-flavored Markdown with headings, bold/italic, links and lists — handy for Notion, GitHub or a static site. You can also download the result as .html, .md or .txt.',
  },
  {
    q: 'Does it work on Google Docs paste?',
    a: 'Yes. Google Docs wraps your text in a docs-internal-guid <b> wrapper and encodes bold/italic as inline font-weight and font-style on spans. We unwrap the Docs wrapper and convert that inline weight and style back to real <strong> and <em> before stripping styles, so you keep your formatting instead of losing it.',
  },
  {
    q: 'Does it remove em dashes and curly quotes too?',
    a: 'No — on purpose. This tool focuses on formatting cruft (Word/Docs junk and PDF line breaks) and deliberately leaves your punctuation, curly quotes and em dashes alone. If you also want grammar-aware em-dash and quote cleanup, the main Em Dash Remover handles that; we link to it after cleaning when we spot leftover quotes or dashes.',
  },
];

const webApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${Astro.site}tools/paste-from-word-docs-cleaner#app`,
  name: 'Paste-from-Word/Docs Cleaner',
  url: `${Astro.site}tools/paste-from-word-docs-cleaner`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web Browser',
  browserRequirements: 'Requires JavaScript.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  isAccessibleForFree: true,
  featureList: [
    'Clean Word HTML — strip mso- styles and MsoNormal classes on paste',
    'Remove Google Docs docs-internal-guid wrapper and inline span soup',
    'Fix PDF copy text — de-hyphenate split words and reflow line breaks',
    'Keep headings, lists, bold and links via a structure allow-list',
    'Output clean HTML, plain text or Markdown',
    '100% client-side — your text never leaves your browser',
  ],
  publisher: { '@id': `${Astro.site}#org` },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Clean Word, Docs & PDF Paste — Strip Formatting, Keep Text (Free)"
  description="Paste from Word, Google Docs or a PDF and get clean text instantly. Removes mso- styles, the docs-internal-guid wrapper and PDF line breaks while keeping headings, lists and links. Free, private, 100% in your browser."
>
  <main class="halo">
    <!-- Hero -->
    <header class="mx-auto max-w-3xl px-4 pt-10 pb-6 text-center">
      <p class="mb-3">
        <a href="/tools" class="text-sm font-medium text-accent hover:underline">← All tools</a>
      </p>
      <p class="mb-3 inline-block rounded-full px-3 py-1 text-xs font-semibold text-accent" style="background: var(--c-accent-soft);">
        100% in your browser · free · no signup
      </p>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
        Clean Word, Google Docs &amp; PDF paste — strip formatting, keep your text.
      </h1>
      <p class="mx-auto mt-3 max-w-2xl text-lg muted">
        Paste straight from Word, Google Docs, or a PDF and the
        <strong>mso- span soup</strong>, inline styles and broken
        <strong>PDF line breaks</strong> are stripped the instant you paste —
        while your headings, lists, bold and links stay intact. Clean writing for
        real quality, with your human voice kept. Nothing is uploaded.
      </p>
    </header>

    <PasteFromWordDocsCleaner />

    <!-- SEO content -->
    <article class="seo mx-auto mt-20 max-w-3xl space-y-5 px-4 leading-relaxed">
      <h2 class="text-2xl font-bold">Paste from Word, Docs, or a PDF — we clean it instantly</h2>
      <p class="muted">
        Most "Word to HTML" cleaners make you find the dirty HTML yourself and
        paste it into a box. This one intercepts the paste itself: it reads the
        hidden rich-HTML payload your clipboard carries (the
        <code>text/html</code> data, not just the plain text) and cleans it the
        moment you press Ctrl/Cmd+V. There is no "Clean" button to hunt for — you
        paste and the clean result is already there, ready to copy as HTML, plain
        text, or Markdown.
      </p>

      <h2 class="text-2xl font-bold">What it removes (and what it keeps)</h2>
      <p class="muted">
        From <strong>Microsoft Word</strong> it strips <code>mso-</code> inline
        styles, <code>MsoNormal</code> and <code>MsoListParagraph</code> classes,
        <code>&lt;o:p&gt;</code>/<code>&lt;w:&gt;</code>/<code>&lt;xml&gt;</code>
        namespace junk, conditional comments and the
        <code>StartFragment</code>/<code>EndFragment</code> markers. From
        <strong>Google Docs</strong> it unwraps the
        <code>docs-internal-guid</code> wrapper and converts inline
        <code>font-weight:700</code> and <code>font-style:italic</code> spans back
        into real <code>&lt;strong&gt;</code> and <code>&lt;em&gt;</code>. What it
        <em>keeps</em> is your actual structure — paragraphs, headings, lists,
        bold, italic and links — via a curated allow-list, so the cleanup never
        flattens content you wanted. Curly quotes and em dashes are left untouched
        on purpose; that is the main cleaner's job.
      </p>

      <h2 class="text-2xl font-bold">Fix PDF copy text — de-hyphenate and reflow line breaks</h2>
      <p class="muted">
        Copying out of a PDF is its own kind of mess: text is stored by visual
        position, so you get one line break per row and words split across line
        wraps (<code>com-</code> then <code>pany</code> on the next line). Turn on
        <strong>Repair PDF line breaks</strong> and the cleaner de-hyphenates
        those split words, reflows soft single line breaks back into real
        paragraphs, and can drop bare page-number lines — while preserving genuine
        paragraph breaks and list items so it never mangles a list, address or
        poem. Because line-break joining is the one operation that can occasionally
        be wrong, it is a toggle you can switch off.
      </p>

      <h2 class="text-2xl font-bold">100% in your browser — your text never leaves your device</h2>
      <p class="muted">
        Every step — reading the clipboard, parsing the HTML, applying the
        allow-list, repairing PDF artifacts — runs locally with the browser's own
        APIs. Nothing is uploaded, there is no account, and there is no logging.
        Open DevTools, switch to the Network tab, and you will see zero requests as
        you paste. That makes it safe for confidential drafts, client work,
        contracts and anything you would not paste into a random website. There is
        even a raw-HTML inspector so you can see the exact <code>mso-</code> payload
        that was cleaned. It is the same provable-privacy promise behind our
        em-dash and AI-text cleaning tools.
      </p>
    </article>

    <!-- FAQ -->
    <section class="mx-auto mt-16 max-w-3xl px-4">
      <h2 class="text-2xl font-bold">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-ink/10">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none font-semibold marker:hidden">
              <span class="inline-flex w-full items-center justify-between">
                {f.q}
                <span class="ml-4 muted transition group-open:rotate-45">+</span>
              </span>
            </summary>
            <p class="mt-2 text-sm muted">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(webApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </main>

  <style is:global>
    @media (max-width: 767px) { body { padding-bottom: 4.5rem; } }
    .seo a { color: var(--color-accent); text-decoration: underline; }
    .seo code { font-family: var(--font-mono); font-size: 0.9em; }
  </style>
</Base>
